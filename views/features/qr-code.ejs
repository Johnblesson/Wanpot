<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wanpot | QR Code Generator</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="icon" href="/images/wanpot.ico" type="image/x-icon">
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: #f8fafc;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 1rem;
    }
    .qr-container {
      width: 100%;
      max-width: 400px;
      background: rgba(255,255,255,0.05);
      border-radius: 15px;
      padding: 2rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
      text-align: center;
    }
    h1 {
      color: #38bdf8;
      margin-bottom: 1rem;
    }
    input {
      width: 90%;
      padding: 0.8rem;
      border-radius: 8px;
      border: none;
      margin-bottom: 1rem;
      background: rgba(255,255,255,0.1);
      color: #f8fafc;
    }
    input::placeholder {
      color: #cbd5e1;
    }
    button {
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      border: none;
      padding: 0.8rem 1.6rem;
      border-radius: 8px;
      color: white;
      font-weight: 600;
      cursor: pointer;
      margin: 0.3rem;
      transition: transform 0.2s;
    }
    button:hover {
      transform: scale(1.05);
    }
    #qr-result {
      margin-top: 1.5rem;
    }
    @media (max-width: 480px) {
      .qr-container {
        padding: 1rem;
      }
      input, button {
        font-size: 0.9rem;
      }
    }
  </style>
</head>
<body>

  <div class="qr-container">
    <h1>QR Code Generator</h1>
    <input type="text" id="qr-text" placeholder="Enter text or URL">
    <div>
      <button id="generate-qr">Generate QR Code</button>
      <button id="download-qr">Download QR</button>
      <button id="copy-qr">Copy Text</button>
    </div>
    <div id="qr-result"></div>
  </div>

  <!-- QRCode.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script>
    let qrcode;
    const qrResult = document.getElementById('qr-result');
    const qrText = document.getElementById('qr-text');
    const generateBtn = document.getElementById('generate-qr');
    const downloadBtn = document.getElementById('download-qr');
    const copyBtn = document.getElementById('copy-qr');

    generateBtn.addEventListener('click', () => {
      qrResult.innerHTML = ""; // Clear previous QR
      const text = qrText.value.trim();
      if (!text) return alert("Enter some text or URL!");
      qrcode = new QRCode(qrResult, {
        text: text,
        width: 200,
        height: 200,
        colorDark: "#38bdf8",
        colorLight: "transparent",
        correctLevel: QRCode.CorrectLevel.H
      });
    });

    downloadBtn.addEventListener('click', () => {
      if (!qrcode) return alert("Generate a QR code first!");
      const img = qrResult.querySelector("img");
      if (!img) return alert("Generate a QR code first!");
      const a = document.createElement('a');
      a.href = img.src;
      a.download = "qr-code.png";
      a.click();
    });

    copyBtn.addEventListener('click', () => {
      const text = qrText.value.trim();
      if (!text) return alert("Enter text to copy!");
      navigator.clipboard.writeText(text)
        .then(() => alert("Text copied to clipboard!"))
        .catch(err => alert("Failed to copy: " + err));
    });
  </script>

</body>
</html>
