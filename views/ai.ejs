<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wanpot AI Chat</title>
  <link rel="icon" href="/images/wanpot.ico" type="image/x-icon">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: #f8fafc;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    header {
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(12px);
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo img {
      height: 40px;
      width: 40px;
      border-radius: 50%;
      object-fit: cover;
    }

    .logo-text {
      font-size: 1.5rem;
      font-weight: 700;
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    header a {
      color: #ffffff;
      font-size: 1.5rem;
      text-decoration: none;
      transition: color 0.2s, transform 0.2s;
    }

    header a:hover {
      color: #f87171;
      transform: scale(1.2);
    }

    .ai-about {
      text-align: center;
      padding: 1rem;
      margin: 1rem auto;
      width: 85%;
      max-width: 800px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      color: #cbd5e1;
    }

    .ai-about h2 {
      color: #38bdf8;
      font-size: 1.3rem;
      margin-bottom: 0.5rem;
    }

    .ai-about p {
      font-size: 0.95rem;
      line-height: 1.5;
      color: #e2e8f0;
    }

    .chat-container {
      flex: 1;
      max-width: 800px;
      margin: 0.5rem auto;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 15px;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      height: 60vh;
    }

    .message {
      padding: 0.8rem 1rem;
      border-radius: 12px;
      margin: 0.6rem 0;
      max-width: 75%;
      line-height: 1.6;
      word-wrap: break-word;
      white-space: pre-wrap;
      animation: fadeIn 0.3s ease;
      overflow-wrap: break-word;
    }

    .user-msg {
      align-self: flex-end;
      background: #3b82f6;
      color: #fff;
      border-bottom-right-radius: 0;
      text-align: right;
    }

    .ai-msg {
      align-self: flex-start;
      background: #1e293b;
      color: #38bdf8;
      border-bottom-left-radius: 0;
      text-align: left;
    }

    .message-wrapper span {
      display: block;
      margin-bottom: 0.3rem;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .chat-input-wrapper {
      width: 90%;
      max-width: 800px;
      margin: 0 auto 1rem auto;
      padding: 0 1rem;
    }

    .input-container {
      position: relative;
      display: flex;
      align-items: center;
      background: rgba(255,255,255,0.1);
      border-radius: 12px;
      overflow: hidden;
    }

    .input-container input[type="text"] {
      width: 100%;
      padding: 0.9rem 3rem 0.9rem 1rem;
      border: none;
      outline: none;
      background: transparent;
      color: #f8fafc;
      font-size: 1rem;
    }

    .input-container input::placeholder {
      color: #94a3b8;
    }

    .input-container button {
      position: absolute;
      right: 0.5rem;
      background: none;
      border: none;
      color: #38bdf8;
      font-size: 1.4rem;
      cursor: pointer;
      transition: color 0.2s, transform 0.2s;
    }

    .input-container button:hover {
      color: #06b6d4;
      transform: scale(1.15);
    }

    .sending i {
      animation: pulse 0.4s ease;
    }

    @keyframes pulse {
      0% { transform: scale(1); color: #38bdf8; }
      50% { transform: scale(1.3); color: #06b6d4; }
      100% { transform: scale(1); color: #38bdf8; }
    }

    footer {
      text-align: center;
      padding: 1rem;
      background: #0f172a;
      color: #64748b;
      font-size: 0.9rem;
    }

    .chat-container::-webkit-scrollbar { width: 8px; }
    .chat-container::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); border-radius: 4px; }
    .chat-container::-webkit-scrollbar-thumb { background: rgba(56,189,248,0.3); border-radius: 4px; }

    .clear-btn {
      display: block;
      margin: 10px auto;
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
      background: #ef4444;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s;
    }
    .clear-btn:hover { background: #dc2626; }

    .ai-typing {
      font-style: italic;
      font-size: 0.9rem;
      color: #94a3b8;
      margin-left: 5px;
      margin-bottom: 5px;
    }

    @media (max-width: 768px) {
      .chat-container { height: 58vh; margin: 0.5rem; padding: 0.8rem; }
      .ai-about { width: 90%; }
    }
    @media (max-width: 480px) {
      .chat-container { height: 55vh; padding: 0.6rem; }
      .message { max-width: 85%; font-size: 0.9rem; }
      .input-container input[type="text"] { padding: 0.7rem 2.8rem 0.7rem 1rem; font-size: 0.9rem; }
      .input-container button { font-size: 1.1rem; right: 0.6rem; }
    }

    /* Animated dots for AI typing */
.ai-typing {
  font-style: italic;
  font-size: 0.9rem;
  color: #94a3b8;
  margin-left: 5px;
  margin-bottom: 5px;
  display: inline-block;
}

.ai-typing::after {
  content: '';
  display: inline-block;
  width: 1em;
  text-align: left;
}

@keyframes typingDots {
  0% { content: ''; }
  25% { content: '.'; }
  50% { content: '..'; }
  75% { content: '...'; }
  100% { content: ''; }
}

.ai-typing::after {
  animation: typingDots 1s infinite steps(4, end);
}
  </style>
</head>
<body>

  <header>
    <div class="logo">
      <a href="/dashboard"><img src="/images/wanpot.ico" alt="Wanpot Logo"></a>
      <span class="logo-text">Wanpot</span>
    </div>
    <a href="/logout" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
  </header>

  <section class="ai-about">
    <h2>Welcome, <%= user.fullname || 'Guest' %></h2>
    <p>
      Wanpot AI is your intelligent assistant powered by next-generation machine learning.
      Ask questions, get instant explanations, brainstorm ideas, or clarify technical and academic concepts —
      all in your familiar Wanpot environment.
    </p>
  </section>

  <button class="clear-btn" onclick="clearAllChat()">🗑️ Clear All Chat</button>

  <div class="chat-container" id="chatContainer"></div>

  <form id="chatForm" class="chat-input-wrapper">
    <div class="input-container">
      <input type="text" name="prompt" id="prompt" placeholder="Type your message, <%= user.fullname || 'Guest' %>..." autocomplete="off" required>
      <button type="submit" id="sendButton"><i class="fas fa-paper-plane"></i></button>
    </div>
    <input type="hidden" name="chatHistory" id="chatHistory" value='<%= JSON.stringify(messages || []) %>'>
    <input type="hidden" name="chatId" id="chatId" value="<%= chatId || '' %>">
  </form>

  <footer>
    <p>© 2025 Wanpot | Built with ❤️ in Sierra Leone by <strong>Kharis Pro Tech</strong> | Empowering Productivity Everywhere</p>
  </footer>

  <script>
    const chatContainer = document.getElementById('chatContainer');
    const chatForm = document.getElementById('chatForm');
    const promptInput = document.getElementById('prompt');
    const chatHistoryInput = document.getElementById('chatHistory');
    const chatIdInput = document.getElementById('chatId');
    const sendButton = document.getElementById('sendButton');

    let chatHistory = chatHistoryInput.value ? JSON.parse(chatHistoryInput.value) : [];
    renderChatHistory(chatHistory);

    function scrollToBottom() { chatContainer.scrollTop = chatContainer.scrollHeight; }

    chatForm.addEventListener('submit', async e => {
      e.preventDefault();
      const prompt = promptInput.value.trim();
      if (!prompt) return;

      sendButton.classList.add('sending');
      setTimeout(() => sendButton.classList.remove('sending'), 400);

      const tempId = Date.now().toString();
      addMessage('user', prompt, tempId);
      chatHistory.push({ _id: tempId, sender: 'user', text: prompt });
      scrollToBottom();
      promptInput.value = '';

      try {
        const res = await fetch('/ai', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt, chatId: chatIdInput.value })
        });
        const data = await res.json();
        chatIdInput.value = data.chatId || chatIdInput.value;
        chatHistory = data.messages;
        renderChatHistory(chatHistory, true);
      } catch (err) {
        console.error(err);
        addMessage('ai', '⚠️ Error generating response. Please try again later.', Date.now().toString());
      }
    });

    function addMessage(sender, text, id, typing=false) {
      const div = document.createElement('div');
      div.classList.add('message', sender === 'user' ? 'user-msg' : 'ai-msg');
      div.setAttribute('data-id', id);

      const wrapper = document.createElement('div');
      wrapper.classList.add('message-wrapper');

      if (sender === 'ai' && typing) {
        const typingIndicator = document.createElement('div');
        typingIndicator.classList.add('ai-typing');
        typingIndicator.textContent = "AI is typing...";
        chatContainer.appendChild(typingIndicator);
        scrollToBottom();

        const span = document.createElement('span');
        wrapper.appendChild(span);
        div.appendChild(wrapper);
        chatContainer.appendChild(div);

        typeWriterEffect(span, text, () => {
          typingIndicator.remove();
        });
      } else {
        const formattedText = text.replace(/\n/g, '<br>');
        wrapper.innerHTML = `<span>${formattedText}</span>`;
        div.appendChild(wrapper);
        chatContainer.appendChild(div);
        scrollToBottom();
      }
    }

    function typeWriterEffect(element, text, callback, i=0) {
      if (i < text.length) {
        element.innerHTML += text[i] === '\n' ? '<br>' : text[i];
        i++;
        setTimeout(() => typeWriterEffect(element, text, callback, i), 20);
        scrollToBottom();
      } else if (callback) callback();
    }

    async function clearAllChat() {
      if (!confirm("Are you sure you want to clear all chat history? This cannot be undone.")) return;
      try {
        const res = await fetch('/ai/clear', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ chatId: chatIdInput.value })
        });
        const data = await res.json();
        chatHistory = data.messages;
        renderChatHistory(chatHistory);
      } catch (err) { console.error(err); }
    }

    function renderChatHistory(history, aiTyping=false) {
      chatContainer.innerHTML = '';
      if (history.length === 0) {
        chatContainer.innerHTML = `<div class="message ai-msg">👋 Hello! I’m Wanpot AI — how can I assist you today?</div>`;
        return;
      }
      history.forEach((msg, index) => {
        if (msg.sender === 'ai' && aiTyping && index === history.length - 1) {
          addMessage(msg.sender, msg.text, msg._id, true);
        } else {
          addMessage(msg.sender, msg.text, msg._id);
        }
      });
      chatHistoryInput.value = JSON.stringify(history);
      scrollToBottom();
    }
  </script>

</body>
</html>
