


  <main>
    <h1>Quick Translator</h1>
    <div class="translator-container">
      <div>
        <label for="textInput">Enter text</label>
        <textarea id="textInput" placeholder="Type or paste text here..."></textarea>
      </div>

      <div style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
        <div style="flex: 1;">
          <label for="sourceLang">From</label>
          <select id="sourceLang">
            <option value="auto">Auto Detect</option>
          </select>
        </div>

        <button id="swapBtn" title="Swap Languages" style="background:none;border:none;color:#38bdf8;font-size:1.5rem;cursor:pointer;">
          <i class="fas fa-exchange-alt"></i>
        </button>

        <div style="flex: 1;">
          <label for="targetLang">To</label>
          <select id="targetLang"></select>
        </div>
      </div>

      <div style="display:flex; gap:0.8rem; flex-wrap:wrap;">
        <button onclick="translateText()"><i class="fas fa-language"></i> Translate</button>
        <button onclick="listenText()"><i class="fas fa-volume-up"></i> Listen</button>
      </div>

      <div class="result-box" id="result">
        <button class="copy-btn" title="Copy" onclick="copyResult()"><i class="fa-solid fa-copy"></i></button>
        Your translation will appear here...
      </div>
    </div>
  </main>

  <script>
    const sourceSelect = document.getElementById("sourceLang");
    const targetSelect = document.getElementById("targetLang");
    const resultDiv = document.getElementById("result");

    const languages = {
      en: "English", fr: "French", es: "Spanish", de: "German",
      ar: "Arabic", zh: "Chinese", ja: "Japanese", ru: "Russian",
      it: "Italian", pt: "Portuguese", hi: "Hindi"
    };

    for (const [code, name] of Object.entries(languages)) {
      sourceSelect.innerHTML += `<option value="${code}">${name}</option>`;
      targetSelect.innerHTML += `<option value="${code}">${name}</option>`;
    }
    targetSelect.value = "fr";

    // Swap languages
    document.getElementById("swapBtn").addEventListener("click", () => {
      const temp = sourceSelect.value;
      sourceSelect.value = targetSelect.value;
      targetSelect.value = temp;
    });

    async function translateText() {
      const text = document.getElementById("textInput").value.trim();
      const from = sourceSelect.value;
      const to = targetSelect.value;
      if (!text) return alert("Please enter text to translate.");
      resultDiv.textContent = "Translating... ⏳";

      try {
        const res = await fetch("/translate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ text, from, to })
        });
        const data = await res.json();
        if (data.translation) {
          resultDiv.innerHTML = `<button class='copy-btn' onclick='copyResult()'><i class='fa-solid fa-copy'></i></button>${data.translation}`;
        } else {
          resultDiv.textContent = "Translation failed.";
        }
      } catch {
        resultDiv.textContent = "Translation error. Please try again.";
      }
    }

    function copyResult() {
      const text = resultDiv.textContent.trim();
      if (text && text !== "Your translation will appear here...") {
        navigator.clipboard.writeText(text);
        alert("Copied to clipboard!");
      }
    }

    function listenText() {
      const text = resultDiv.textContent.trim();
      if (!text || text === "Your translation will appear here...") return;

      const utter = new SpeechSynthesisUtterance(text);
      const langCode = targetSelect.value;
      // Map some language codes to SpeechSynthesis
      if(langCode === "zh") utter.lang = "zh-CN";
      else if(langCode === "ar") utter.lang = "ar-SA";
      else utter.lang = langCode;

      speechSynthesis.speak(utter);
    }

    function toggleMenu() {
      document.querySelector("nav ul").classList.toggle("active");
    }
  </script>

  