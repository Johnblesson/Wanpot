<style>

    /* ==============================
       CONTAINER
    ============================== */
    .code-helper-container {
      width: 93%;
      max-width: 950px;
      margin: 20px auto 50px;
      margin-top: 115px;
      background: rgba(255,255,255,0.06);
      padding: 2rem;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
      box-shadow: 0 0 40px rgba(6,182,212,0.15);
      animation: fadeIn 0.8s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ==============================
       TITLE
    ============================== */
    .ai-title {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 1.4rem;
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .ai-title i {
      font-size: 2rem;
      color: #38bdf8;
    }

    /* ==============================
       TEXTAREA
    ============================== */
    .prompt-input {
      width: 95%;
      min-height: 150px;
      padding: 1.2rem;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(0,0,0,0.3);
      color: #e2e8f0;
      resize: none;
      font-size: 1rem;
      line-height: 1.5;
      transition: 0.3s;
    }

    .prompt-input:focus {
      border-color: #38bdf8;
      box-shadow: 0 0 10px rgba(59,130,246,0.5);
    }

    /* ==============================
       RUN BUTTON
    ============================== */
    .run-btn {
      margin-top: 1rem;
      width: 100%;
      padding: 1rem;
      border-radius: 12px;
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      color: #fff;
      border: none;
      cursor: pointer;
      font-size: 1.1rem;
      font-weight: 600;
      transition: 0.3s;
    }

    .run-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 30px rgba(6,182,212,0.35);
    }

    /* ==============================
       LOADER
    ============================== */
    .loader {
      margin-top: 10px;
      display: none;
      text-align: center;
      font-size: 1rem;
      color: #38bdf8;
      animation: pulse 1.2s infinite;
    }

    @keyframes pulse {
      0% {opacity: 0.4;}
      50% {opacity: 1;}
      100% {opacity: 0.4;}
    }

    /* ==============================
       RESPONSE
    ============================== */
    .response-box {
      margin-top: 1.4rem;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.1);
      padding: 1.2rem;
      border-radius: 15px;
      white-space: pre-wrap;
      font-family: Consolas, monospace;
      font-size: 0.95rem;
      display: none;
      position: relative;
      overflow-x: auto;
    }

    /* ==============================
       COPY BUTTON
    ============================== */
    .copy-btn {
      position: absolute;
      top: 10px;
      right: 12px;
      padding: 6px 12px;
      background: rgba(0,0,0,0.5);
      border: 1px solid #38bdf8;
      color: #38bdf8;
      border-radius: 8px;
      cursor: pointer;
    }

    .copy-btn:hover {
      background: #38bdf8;
      color: #fff;
    }

    /* ==============================
       RESPONSIVE
    ============================== */
    @media (max-width: 768px) {
      .ai-title { font-size: 1.6rem; }
      .ai-title i { font-size: 1.8rem; }
      .wp-header-title { font-size: 1.2rem; }
      .wp-header img { width: 40px; height: 40px; }
      .prompt-input { width: 100%; font-size: 0.95rem; }
      .code-helper-container { padding: 1.5rem; border-radius: 16px; }
    }

    @media (max-width: 480px) {
      .ai-title { font-size: 1.4rem; gap: 8px; }
      .ai-title i { font-size: 1.5rem; }
      .wp-header-title { font-size: 1rem; }
      .wp-header img { width: 36px; height: 36px; }
      .prompt-input { min-height: 120px; font-size: 0.9rem; }
      .run-btn { padding: 0.85rem; font-size: 1rem; }
      .code-helper-container { padding: 1rem; margin: 15px auto 40px; }
    }

    @media (max-width: 360px) {
      .ai-title { font-size: 1.3rem; gap: 6px; }
      .ai-title i { font-size: 1.4rem; }
      .wp-header-title { font-size: 0.95rem; }
      .prompt-input { min-height: 100px; font-size: 0.88rem; padding: 1rem; }
      .run-btn { padding: 0.75rem; font-size: 0.95rem; }
    }
  </style>
</head>
<body>

  <!-- BRAINSTORM CONTAINER -->
  <div class="code-helper-container">
    <div class="ai-title">
      <i class="fas fa-brain"></i> AI Brainstorming Tool
    </div>

    <textarea id="prompt" class="prompt-input" placeholder="Enter your idea, project concept, or challenge here..."></textarea>
    <button class="run-btn" id="runBrainstorm">Generate Ideas</button>

    <div class="loader" id="loader">⏳ AI is thinking...</div>

    <div id="response" class="response-box">
      <button class="copy-btn" id="copyBtn">Copy</button>
    </div>
  </div>

  <!-- JAVASCRIPT -->
  <script>
    const promptBox = document.getElementById("prompt");
    const responseBox = document.getElementById("response");
    const loader = document.getElementById("loader");

    // Auto-resize textarea
    promptBox.addEventListener("input", () => {
      promptBox.style.height = "auto";
      promptBox.style.height = promptBox.scrollHeight + "px";
    });

    // Run Brainstorm
    document.getElementById("runBrainstorm").addEventListener("click", async () => {
      const prompt = promptBox.value.trim();
      if (!prompt) return;

      loader.style.display = "block";
      responseBox.style.display = "none";

      try {
        const res = await fetch("/ai/brainstorm/run", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ prompt })
        });
        const data = await res.json();

        loader.style.display = "none";
        responseBox.style.display = "block";
        responseBox.innerHTML = `<button class='copy-btn' id='copyBtn'>Copy</button>${data.error ? "❌ " + data.error : data.response}`;
      } catch {
        loader.style.display = "none";
        responseBox.style.display = "block";
        responseBox.innerHTML = `<button class='copy-btn' id='copyBtn'>Copy</button>❌ Network or server error.`;
      }
    });

    // Copy to clipboard
    document.addEventListener("click", (e) => {
      if (e.target.id === "copyBtn") {
        const text = responseBox.innerText.replace("Copy", "").trim();
        navigator.clipboard.writeText(text);
        e.target.innerText = "Copied!";
        setTimeout(() => e.target.innerText = "Copy", 1400);
      }
    });
  </script>
