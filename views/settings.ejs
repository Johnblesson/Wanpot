<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WANPOT | Settings</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: #f8fafc;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 4rem 1rem;
    }

    h2.page-heading {
      font-size: 1.8rem;
      font-weight: 600;
      margin-bottom: 2rem;
      color: #60a5fa;
      text-align: center;
      text-shadow: 0 0 12px rgba(96,165,250,0.6);
    }

    .card-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
      width: 100%;
      max-width: 900px;
      margin-bottom: 3rem;
    }

    .card {
      background: rgba(30, 41, 59, 0.8);
      border-radius: 16px;
      padding: 1.5rem;
      text-align: center;
      color: #e2e8f0;
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s ease;
      border: 1px solid rgba(255,255,255,0.1);
      box-shadow: 0 0 20px rgba(37,99,235,0.1);
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 25px rgba(96,165,250,0.5);
      border-color: #3b82f6;
      color: #3b82f6;
    }

    .two-factor-form {
      background: rgba(30, 41, 59, 0.9);
      border-radius: 16px;
      padding: 2.5rem;
      width: 100%;
      max-width: 600px;
      border: 1px solid rgba(255,255,255,0.1);
      box-shadow: 0 0 30px rgba(37,99,235,0.2);
    }

    .two-factor-form h2 {
      font-size: 1.6rem;
      color: #60a5fa;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    .two-factor-form form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1rem;
      color: #cbd5e1;
    }

    input[type="radio"] {
      accent-color: #3b82f6;
      transform: scale(1.2);
      cursor: pointer;
    }

    button {
      background: linear-gradient(90deg, #2563eb, #3b82f6);
      border: none;
      padding: 0.9rem 2rem;
      border-radius: 10px;
      color: #fff;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-top: 1rem;
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 15px #3b82f6;
    }

    p {
      margin-top: 1rem;
      text-align: center;
      color: #94a3b8;
    }

    strong {
      color: #60a5fa;
    }

    @media (max-width: 600px) {
      body {
        padding: 2rem 1rem;
      }
      .two-factor-form {
        padding: 2rem 1.2rem;
      }
    }
  </style>
</head>
<body>
  <h2 class="page-heading">Settings</h2>

  <div class="card-container">
    <a href="/update-profile/<%= user._id %>" class="card">Edit Profile</a>
    <a href="/update-password/<%= user._id %>" class="card">Change Password</a>
    <a href="#" class="card" onclick="redirectToFaq('<%= role %>')">AgroTech FAQ</a>
    <a href="/login-history" class="card">Devices</a>
    <a href="/logout" class="card">Logout</a>
  </div>

  <div class="two-factor-form">
    <h2>Two-Factor Authentication</h2>
    <form action="/2fa" method="POST">
      <label>
        <input type="radio" name="twoFactorAuth" value="enable" <%= user.twoFactorEnabled ? 'checked' : '' %>> Enable 2FA
      </label>
      <label>
        <input type="radio" name="twoFactorAuth" value="disable" <%= !user.twoFactorEnabled ? 'checked' : '' %>> Disable 2FA
      </label>
      <button type="submit">Save Changes</button>
    </form>

    <% if (user.twoFactorEnabled) { %>
      <p>2FA is currently <strong>enabled</strong>.</p>
    <% } else { %>
      <p>2FA is currently <strong>disabled</strong>.</p>
    <% } %>
  </div>

  <script>
    function redirectToFaq(role) {
      if (role === 'admin') {
        window.location.href = '/faq-admin';
      } else if (role === 'user') {
        window.location.href = '/faq';
      }
    }
  </script>
</body>
</html>
