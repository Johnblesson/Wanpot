<style>
/* ===============================
   General Page Styling
================================ */
main h1 {
  text-align: center;
  font-size: 2rem;
  font-weight: 700;
  margin-top: 75px;
  background: linear-gradient(90deg,#3b82f6,#06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ===============================
   Recorder Container
================================ */
.recorder-container {
  background: rgba(15,23,42,0.85);
  border-radius: 20px;
  padding: 2rem;
  max-width: 950px;
  margin: 0 auto 2rem;
  margin-top: 40px;
  box-shadow: 0 10px 40px rgba(6,182,212,0.2);
  border: 1px solid rgba(59,130,246,0.3);
  backdrop-filter: blur(6px);
  text-align: center;
}

/* ===============================
   Record Button
================================ */
#recordBtn {
  background: linear-gradient(90deg, #3b82f6, #06b6d4);
  color: #fff;
  border: none;
  border-radius: 50%;
  width: 90px;
  height: 90px;
  font-size: 2rem;
  cursor: pointer;
  transition: 0.3s ease;
  box-shadow: 0 5px 20px rgba(6,182,212,0.3);
}

#recordBtn:hover {
  transform: scale(1.05);
}

#recordBtn.recording {
  background: linear-gradient(90deg, #ef4444, #f97316);
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(239,68,68,0.6); }
  70% { box-shadow: 0 0 0 20px rgba(239,68,68,0); }
  100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); }
}

/* ===============================
   Transcript Box
================================ */
#transcript {
  background: rgba(30,41,59,0.9);
  margin-top: 1.5rem;
  padding: 1rem;
  border-radius: 14px;
  text-align: left;
  min-height: 160px;
  color: #e2e8f0;
  font-size: 1rem;
  line-height: 1.6;
  white-space: pre-wrap;
  border: 1px solid rgba(59,130,246,0.3);
  box-shadow: inset 0 2px 6px rgba(6,182,212,0.1);
}

/* ===============================
   Control Buttons
================================ */
.controls {
  margin-top: 1.5rem;
  display: flex;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}

button.action {
  background: rgba(59,130,246,0.2);
  border: none;
  color: #fff;
  padding: 0.7rem 1.2rem;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  transition: 0.3s;
}

button.action:hover {
  background: linear-gradient(90deg, #3b82f6, #06b6d4);
  transform: scale(1.05);
}

/* ===============================
   Responsive
================================ */
@media (max-width: 768px) {
  .recorder-container { padding: 1.5rem; }
  .controls { flex-direction: column; width: 100%; }
  button.action { width: 100%; }
}
</style>
<main>
  <h1>Voice-to-Text Recorder</h1>

  <div class="recorder-container">
    <button id="recordBtn"><i class="fas fa-microphone"></i></button>
    <div id="transcript">🎙️ Start speaking to record your note...</div>

    <div class="controls">
      <button id="copyBtn" class="action"><i class="fas fa-copy"></i> Copy</button>
      <button id="downloadBtn" class="action"><i class="fas fa-download"></i> Download</button>
      <button id="clearBtn" class="action"><i class="fas fa-trash"></i> Clear</button>
    </div>
  </div>
</main>

<script>
  const recordBtn = document.getElementById('recordBtn');
  const transcriptEl = document.getElementById('transcript');
  const copyBtn = document.getElementById('copyBtn');
  const downloadBtn = document.getElementById('downloadBtn');
  const clearBtn = document.getElementById('clearBtn');

  let recognition;
  let isRecording = false;
  let finalTranscript = "";

  // Initialize speech recognition safely
  if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = 'en-US';
  } else {
    alert("Sorry, your browser doesn't support Speech Recognition. Please use Chrome or Edge.");
  }

  // ▶️ Start / Stop Recording
  recordBtn.addEventListener('click', () => {
    if (!recognition) return;

    if (isRecording) {
      recognition.stop();
      isRecording = false;
      recordBtn.classList.remove('recording');
      recordBtn.innerHTML = '<i class="fas fa-microphone"></i>';
    } else {
      finalTranscript = "";   // reset text before a new session
      transcriptEl.textContent = "Listening...";
      recognition.start();
      isRecording = true;
      recordBtn.classList.add('recording');
      recordBtn.innerHTML = '<i class="fas fa-stop"></i>';
    }
  });

  // 🎤 Handle recognition output safely
  recognition.onresult = (event) => {
    let interim = "";

    for (let i = event.resultIndex; i < event.results.length; i++) {
      const transcript = event.results[i][0].transcript;

      if (event.results[i].isFinal) {
        finalTranscript += transcript + " ";
      } else {
        interim += transcript;
      }
    }

    transcriptEl.textContent = finalTranscript + interim;
  };

  // 🛑 Prevent auto-stop on long silence
  recognition.onend = () => {
    if (isRecording) {
      recognition.start(); // restart automatically
    }
  };

  // ❌ Error handler (prevents crashes)
  recognition.onerror = (e) => {
    console.error("Speech Recognition Error:", e);
  };

  // 📋 Copy to clipboard
  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(transcriptEl.textContent);
    alert("Copied to clipboard!");
  });

  // ⬇️ Download transcript
  downloadBtn.addEventListener('click', () => {
    const text = transcriptEl.textContent.trim();
    if (!text) return;

    const blob = new Blob([text], { type: "text/plain" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = "transcript.txt";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // 🗑️ Clear transcript
  clearBtn.addEventListener('click', () => {
    finalTranscript = "";
    transcriptEl.textContent = "🎙️ Start speaking to record your note...";
  });
</script>
