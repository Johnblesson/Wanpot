<style>
/* ---- NOTEPAD CONTAINER ---- */
.notepad-container {
  max-width: 750px;
  margin: 80px auto 40px;
  margin-top: 105px;
  background: rgba(30, 41, 59, 0.95); /* Wanpot dark theme */
  border-radius: 18px;
  padding: 30px 35px;
  box-shadow: 0 8px 25px rgba(6, 182, 212, 0.2);
  color: #e2e8f0;
  animation: fadeIn 0.8s ease;
}

/* Note Title */
.note-title {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 20px;
  color: #38bdf8;
}

/* Note Content */
.note-content {
  white-space: pre-wrap;
  font-size: 17px;
  line-height: 1.7;
  color: #cbd5e1;
  margin-bottom: 25px;
}

/* Back Button */
.back-btn {
  display: inline-block;
  background: #38bdf8;
  padding: 10px 22px;
  color: #fff;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  transition: 0.2s ease;
}

.back-btn:hover {
  background: #0ea5e9;
}

/* Fade In Animation */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---- RESPONSIVE ---- */
@media (max-width: 600px) {
 .notepad-container {
    margin: 60px 15px;
    margin-top: 105px;
    padding: 20px;
  }

  .note-title {
    font-size: 22px;
  }

  .note-content {
    font-size: 15px;
  }

  .back-btn {
    padding: 8px 18px;
    font-size: 14px;
  }
}
</style>

<div class="notepad-container">
  <h1 class="note-title"><%= note.title %></h1>

  <div class="note-content">
    <%= note.content %>
  </div>

  <a href="/notes" class="back-btn">← Back to Notes</a>
</div>
