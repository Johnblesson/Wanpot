<!DOCTYPE html>
<html lang="en">
<head>

  <style>
    body {
      background: #0f172a;
      font-family: 'Poppins', sans-serif;
    }
    .code-helper-container {
      width: 95%;
      max-width: 900px;
      margin: 40px auto;
      background: rgba(15, 23, 42, 0.95);
      padding: 2rem;
      border-radius: 16px;
      box-shadow: 0 0 25px rgba(0, 132, 255, 0.3);
      color: #e2e8f0;
      animation: fadeIn 0.8s ease;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .ai-title {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 1.7rem;
      font-weight: 600;
      color: #38bdf8;
      margin-bottom: 1.3rem;
    }
    .ai-title i { font-size: 1.9rem; color: #3b82f6; }
    .prompt-input {
      width: 100%;
      background: #0f172a;
      border: 1px solid #334155;
      padding: 1rem;
      border-radius: 10px;
      color: #e2e8f0;
      min-height: 140px;
      resize: none;
      font-size: 1rem;
      line-height: 1.5;
      transition: 0.3s;
    }
    .prompt-input:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
    }
    .run-btn {
      margin-top: 1rem;
      width: 100%;
      padding: 0.9rem;
      background: linear-gradient(90deg, #2563eb, #3b82f6);
      border: none;
      color: #fff;
      border-radius: 10px;
      cursor: pointer;
      font-size: 1.1rem;
      letter-spacing: 1px;
      transition: 0.3s ease;
    }
    .run-btn:hover {
      background: linear-gradient(90deg, #1d4ed8, #2563eb);
      transform: translateY(-2px);
    }
    .response-box {
      margin-top: 1.5rem;
      background: #0f172a;
      border: 1px solid #475569;
      padding: 1rem;
      border-radius: 12px;
      white-space: pre-wrap;
      font-family: "Consolas", monospace;
      font-size: 0.95rem;
      display: none;
      position: relative;
      animation: fadeIn 0.4s ease;
    }
    .copy-btn {
      position: absolute;
      top: 8px;
      right: 10px;
      background: #1e293b;
      border: 1px solid #3b82f6;
      color: #3b82f6;
      padding: 5px 10px;
      font-size: 0.8rem;
      border-radius: 6px;
      cursor: pointer;
      transition: 0.2s;
    }
    .copy-btn:hover {
      background: #3b82f6;
      color: #fff;
    }
    .loader {
      margin-top: 12px;
      text-align: center;
      display: none;
      color: #38bdf8;
      font-size: 1rem;
    }
    @media (max-width: 600px) {
      .ai-title { font-size: 1.4rem; }
      .ai-title i { font-size: 1.4rem; }
    }
  </style>
</head>

<body>
  <div class="code-helper-container">
    <div class="ai-title">
      <i class="fa-solid fa-code"></i> Wanpot AI Code Helper
    </div>

    <textarea 
      id="prompt" 
      class="prompt-input" 
      placeholder="Ask me to generate code, debug errors, write documentation, explain a bug, optimize scripts...">
    </textarea>

    <button class="run-btn" id="runAI">Run AI Assistant</button>

    <!-- Loader -->
    <div class="loader" id="loader">⏳ AI is thinking...</div>

    <!-- AI Response -->
    <div id="response" class="response-box">
      <button class="copy-btn" id="copyBtn">Copy</button>
    </div>
  </div>

  <script>
    const promptBox = document.getElementById("prompt");
    const responseBox = document.getElementById("response");
    const loader = document.getElementById("loader");
    const copyBtn = document.getElementById("copyBtn");

    // Auto expand textarea
    promptBox.addEventListener("input", () => {
      promptBox.style.height = "auto";
      promptBox.style.height = (promptBox.scrollHeight) + "px";
    });

    document.getElementById('runAI').addEventListener('click', async () => {
      const prompt = promptBox.value.trim();
      if (!prompt) return;

      loader.style.display = "block";
      responseBox.style.display = "none";

      try {
        const res = await fetch("/dev/ai-code-helper/run", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ prompt })
        });

        const data = await res.json();
        loader.style.display = "none";
        responseBox.style.display = "block";

        if (data.error) {
          responseBox.innerHTML = `<button class='copy-btn' id='copyBtn'>Copy</button>❌ ${data.error}`;
        } else {
          responseBox.innerHTML = `<button class='copy-btn' id='copyBtn'>Copy</button>${data.response}`;
        }
      } catch (err) {
        loader.style.display = "none";
        responseBox.style.display = "block";
        responseBox.innerHTML = `<button class='copy-btn' id='copyBtn'>Copy</button>❌ Network or server error.`;
      }
    });

    // Copy to clipboard
    document.addEventListener("click", (e) => {
      if (e.target.id === "copyBtn") {
        const text = responseBox.innerText.replace("Copy", "").trim();
        navigator.clipboard.writeText(text);
        e.target.innerText = "Copied!";
        setTimeout(() => e.target.innerText = "Copy", 1500);
      }
    });
  </script>
</body>
</html>
