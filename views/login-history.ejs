<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="/img/dperfect.png" type="image/x-icon">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<title>Wanpot | Login History</title>
<style>
/* Global Styles */
body {
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg,#0f172a,#1e293b);
    color: #f8fafc;
    margin: 0;
    padding: 20px;
}

/* Card Styles */
.card {
    background: rgba(30,41,59,0.95);
    padding: 25px 30px;
    border-radius: 20px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.5);
    margin: 20px auto;
    max-width: 800px;
    transition: transform 0.2s ease;
}

.card:hover {
    transform: translateY(-3px);
}

.card h2 {
    font-size: 22px;
    color: #38bdf8;
    margin-bottom: 15px;
}

.card p, .card li {
    font-size: 15px;
    color: #cbd5e1;
}

.login-history-list {
    list-style: none;
    padding: 0;
}

.login-history-item {
    position: relative;
    background: #1e293b;
    padding: 15px 20px;
    border-radius: 12px;
    margin-bottom: 12px;
    border-left: 5px solid #38bdf8;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
}

.remove-icon {
    position: absolute;
    top: 12px;
    right: 12px;
    color: #ef4444;
    text-decoration: none;
    transition: color 0.2s;
}

.remove-icon:hover {
    color: #f87171;
}

.remove-icon i {
    font-size: 16px;
}

/* Clear All Button */
.clear-history-btn {
    display: inline-block;
    margin-top: 15px;
    padding: 12px 20px;
    background: #38bdf8;
    color: #0f172a;
    border: none;
    border-radius: 12px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: all 0.2s;
}

.clear-history-btn:hover {
    background: #0ea5e9;
    transform: translateY(-2px);
}

/* Alert Box */
.alert {
    padding: 20px;
    border-radius: 12px;
    max-width: 800px;
    margin: 30px auto;
    font-size: 16px;
    text-align: center;
    transition: opacity 0.5s ease-out;
}

.alert-success {
    background: #10b98120;
    color: #10b981;
    border: 1px solid #10b98160;
}

.alert-success:hover {
    background: #10b98130;
}

.hidden {
    opacity: 0;
}

/* Responsive */
@media(max-width:600px){
    .card {
        padding: 20px;
        margin: 15px auto;
    }
    .card h2 {
        font-size: 20px;
    }
    .login-history-item {
        padding: 12px 15px;
    }
    .clear-history-btn {
        width: 100%;
        padding: 12px;
    }
}
@media(max-width:400px){
    .card h2 {
        font-size: 18px;
    }
}
</style>
</head>
<body>

<!-- Success Alert -->
<% if (alert) { %>
    <div id="success-alert" class="alert alert-success">
      <%= alert %>
    </div>
<% } %>

<!-- Current Device Info -->
<div class="card">
    <h2>This Device</h2>
    <p><strong>IP Address:</strong> <%= user.lastLoginIP %></p>
    <p><strong>Device:</strong> <%= user.lastLoginDevice %></p>
    <p><strong>Country:</strong> <%= user.lastLoginCountry %></p>
</div>

<!-- Login History -->
<div class="card">
    <h2>Login History</h2>
    <ul class="login-history-list">
        <% user.loginHistory.forEach(history => { %>
            <li class="login-history-item">
                <strong>Date:</strong> <%= new Date(history.date).toLocaleString('en-US', {
                    year: 'numeric', month: '2-digit', day: '2-digit',
                    hour: '2-digit', minute: '2-digit', second: '2-digit'
                }) %><br>
                <strong>IP:</strong> <%= history.ip %><br>
                <strong>Device:</strong> <%= history.device %><br>
                <strong>Country:</strong> <%= history.country %>
                <a href="/remove-login-history/<%= history._id %>" class="remove-icon" title="Remove">
                    <i class="fas fa-trash-alt"></i>
                </a>
            </li>
        <% }) %>
    </ul>

    <form action="/clear-login-history" method="POST">
        <button type="submit" class="clear-history-btn">Clear All Login History</button>
    </form>
</div>

<script>
// Auto-hide alert after 10 seconds
document.addEventListener('DOMContentLoaded', function() {
    const alertBox = document.getElementById('success-alert');
    if (alertBox) {
        setTimeout(() => {
            alertBox.classList.add('hidden');
        }, 10000);
    }
});
</script>
</body>
</html>
