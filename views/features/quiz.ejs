<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wanpot | Tech Quiz</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="icon" href="/images/wanpot.ico" type="image/x-icon">
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: radial-gradient(circle at top left, #0f172a, #1e293b, #0a0f1a);
      color: #f8fafc;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 1rem;
    }

    .quiz-container {
      width: 100%;
      max-width: 700px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 20px;
      padding: 2.5rem;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
      animation: fadeIn 0.6s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    h1 {
      text-align: center;
      margin-bottom: 2rem;
      color: #38bdf8;
      font-size: 2rem;
      letter-spacing: 1px;
    }

    .question {
      font-size: 1.4rem;
      margin-bottom: 1.2rem;
      line-height: 1.5;
      color: #e2e8f0;
    }

    .options {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .option-btn {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid transparent;
      padding: 1rem;
      border-radius: 10px;
      color: #f8fafc;
      cursor: pointer;
      font-size: 1rem;
      font-weight: 500;
      text-align: left;
      transition: all 0.3s ease;
    }

    .option-btn:hover {
      background: rgba(56, 189, 248, 0.15);
      border-color: #38bdf8;
      transform: scale(1.02);
    }

    .option-btn.correct {
      background: #16a34a;
      border-color: #22c55e;
      color: #fff;
    }

    .option-btn.wrong {
      background: #dc2626;
      border-color: #ef4444;
      color: #fff;
    }

    .controls {
      margin-top: 2rem;
      text-align: right;
    }

    #next-btn, #restart-btn {
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      border: none;
      padding: 0.9rem 2rem;
      border-radius: 10px;
      color: #fff;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      font-size: 1rem;
    }

    #next-btn:hover, #restart-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(6, 182, 212, 0.4);
    }

    #score-section {
      display: none;
      text-align: center;
      margin-top: 2rem;
      animation: fadeIn 0.5s ease;
    }

    #score {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      color: #38bdf8;
    }

    footer {
      text-align: center;
      font-size: 0.9rem;
      color: #94a3b8;
      margin-top: 1.5rem;
    }

    footer i {
      color: #38bdf8;
    }
  </style>
</head>
<body>
  <div class="quiz-container">
    <h1><i class="fa-solid fa-microchip"></i> Wanpot Tech Quiz</h1>

    <div id="quiz-area">
      <div class="question" id="question"></div>
      <div class="options" id="options"></div>
      <div class="controls">
        <button id="next-btn">Next Question</button>
      </div>
    </div>

    <div id="score-section">
      <p id="score"></p>
      <button id="restart-btn">Play Again</button>
    </div>

    <footer>
      Powered by <i class="fa-solid fa-bolt"></i> Wanpot AI
    </footer>
  </div>

  <script>
    let questions = [];
    let current = 0;
    let score = 0;

    const questionEl = document.getElementById('question');
    const optionsEl = document.getElementById('options');
    const nextBtn = document.getElementById('next-btn');
    const quizArea = document.getElementById('quiz-area');
    const scoreSection = document.getElementById('score-section');
    const scoreEl = document.getElementById('score');
    const restartBtn = document.getElementById('restart-btn');

    async function fetchQuiz() {
      try {
        const resp = await fetch('/data/questions.json');
        questions = await resp.json();
        shuffleArray(questions);
        showQuestion();
      } catch (err) {
        console.error('Error loading questions:', err);
        questionEl.textContent = 'Failed to load quiz.';
      }
    }

    function showQuestion() {
      const q = questions[current];
      questionEl.textContent = q.question;
      optionsEl.innerHTML = '';
      const options = [...q.options];
      shuffleArray(options);
      options.forEach(option => {
        const btn = document.createElement('button');
        btn.classList.add('option-btn');
        btn.textContent = option;
        btn.onclick = () => selectAnswer(btn, option, q.answer);
        optionsEl.appendChild(btn);
      });
    }

    function selectAnswer(button, option, correct) {
      const btns = document.querySelectorAll('.option-btn');
      btns.forEach(b => b.disabled = true);

      if (option === correct) {
        score++;
        button.classList.add('correct');
      } else {
        button.classList.add('wrong');
        btns.forEach(b => {
          if (b.textContent === correct) b.classList.add('correct');
        });
      }
    }

    nextBtn.addEventListener('click', () => {
      current++;
      if (current < questions.length) {
        showQuestion();
      } else {
        showScore();
      }
    });

    function showScore() {
      quizArea.style.display = 'none';
      scoreSection.style.display = 'block';
      scoreEl.textContent = `🎯 You scored ${score} / ${questions.length}`;
    }

    restartBtn.addEventListener('click', () => {
      current = 0;
      score = 0;
      quizArea.style.display = 'block';
      scoreSection.style.display = 'none';
      fetchQuiz();
    });

    function shuffleArray(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
    }

    fetchQuiz();
  </script>
</body>
</html>
