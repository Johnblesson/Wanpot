  * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: #f8fafc;
      overflow-x: hidden;
    }

    header {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 100;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .navbar {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.7rem;
      font-weight: 700;
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 1.5rem;
    }

    nav ul li a {
      text-decoration: none;
      color: #f1f5f9;
      font-weight: 500;
      transition: color 0.3s;
    }

    nav ul li a:hover {
      color: #38bdf8;
    }

    .menu-toggle {
      display: none;
      font-size: 1.8rem;
      cursor: pointer;
      color: #fff;
    }

/* MAIN */
main{flex:1;padding:6rem 2rem 2rem;max-width:1200px;margin:auto;display:flex;gap:2rem;flex-wrap:wrap;}
h1{text-align:center;width:100%;margin-bottom:2rem;color:#38bdf8;font-size:2rem;}

/* FORM */
.resume-form{flex:1;min-width:300px;background:rgba(255,255,255,0.05);padding:1.8rem;border-radius:15px;box-shadow:0 4px 20px rgba(0,0,0,0.3);}
.resume-form label{display:block;margin-bottom:0.3rem;font-weight:600;}
.resume-form input, .resume-form textarea, .resume-form select{width:100%;padding:0.8rem 1rem;margin-bottom:1rem;border-radius:8px;border:none;background:rgba(255,255,255,0.1);color:#f8fafc;font-size:1rem;outline:none;resize:vertical;}
.resume-form textarea::placeholder,.resume-form input::placeholder{color:#94a3b8;}
.resume-form button{background:linear-gradient(90deg,#3b82f6,#06b6d4);border:none;padding:0.8rem 1.5rem;border-radius:8px;color:#fff;font-weight:600;cursor:pointer;transition:transform 0.2s;margin-right:0.5rem;margin-bottom:0.5rem;}
.resume-form button:hover{transform:scale(1.05);}

/* DYNAMIC ENTRIES */
.dynamic-list{margin-bottom:1rem;}
.dynamic-list button{margin-top:0.3rem;font-size:0.85rem;}

/* PREVIEW */
.resume-preview{flex:1;min-width:300px;background:rgba(255,255,255,0.05);padding:1.8rem;border-radius:15px;box-shadow:0 4px 20px rgba(0,0,0,0.3);overflow:auto;max-height:80vh;}
.resume-preview h2{margin-bottom:0.5rem;}
.resume-preview p{margin-bottom:0.5rem;}
.resume-preview .section-title{margin-top:1rem;margin-bottom:0.5rem;font-weight:600;text-decoration:underline;}

/* TEMPLATES */
.resume-preview.classic{color:#e2e8f0;}
.resume-preview.modern h2{color:#3b82f6;font-weight:700;}
.resume-preview.modern .section-title{color:#06b6d4;}
.resume-preview.minimal h2{font-weight:700;}
.resume-preview.minimal .section-title{color:#38bdf8;text-decoration:none;}

/* FOOTER */
footer{text-align:center;padding:2rem 1rem;background:#0f172a;color:#64748b;font-size:0.9rem;border-top:1px solid rgba(255,255,255,0.1);margin-top:auto;}

/* RESPONSIVE */
@media(max-width:1024px){main{flex-direction:column;}}
@media(max-width:768px){.menu-toggle{display:block;}nav ul{display:none;flex-direction:column;position:absolute;right:20px;top:60px;background:rgba(15,23,42,0.95);border-radius:10px;padding:1rem;}nav ul.active{display:flex;}}
@media(max-width:480px){main{padding:6rem 1rem 2rem;}}
</style>
</head>

<body>
<header>
<div class="navbar">
  <div class="logo">Wanpot</div>
  <i class="fas fa-bars menu-toggle" onclick="toggleMenu()"></i>
  <nav>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/translator">Translator</a></li>
      <li><a href="/resume">Resume Builder</a></li>
    </ul>
  </nav>
</div>
</header>

<main>
  <!-- FORM -->
  <div class="resume-form">
    <h2>Fill Your Resume</h2>

    <label for="fullName">Full Name</label>
    <input type="text" id="fullName" placeholder="John Doe">

    <label for="email">Email</label>
    <input type="email" id="email" placeholder="john@example.com">

    <label for="phone">Phone</label>
    <input type="text" id="phone" placeholder="+1234567890">

    <label for="summary">Professional Summary</label>
    <textarea id="summary" rows="3" placeholder="Brief about you..."></textarea>

    <!-- Dynamic Education -->
    <div class="dynamic-list" id="educationList">
      <label>Education</label>
      <div><input type="text" placeholder="Degree, Institution, Year"></div>
      <button type="button" onclick="addEntry('educationList')"><i class="fas fa-plus"></i> Add More</button>
    </div>

    <!-- Dynamic Experience -->
    <div class="dynamic-list" id="experienceList">
      <label>Experience</label>
      <div><input type="text" placeholder="Company, Role, Duration"></div>
      <button type="button" onclick="addEntry('experienceList')"><i class="fas fa-plus"></i> Add More</button>
    </div>

    <label for="skills">Skills (comma separated)</label>
    <input type="text" id="skills" placeholder="JavaScript, Node.js, Photoshop">

    <label for="templateSelect">Choose Template</label>
    <select id="templateSelect">
      <% templates.forEach(t => { %>
        <option value="<%= t %>"><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
      <% }) %>
    </select>

    <label for="colorSelect">Choose Primary Color</label>
    <select id="colorSelect">
      <% colors.forEach(c => { %>
        <option value="<%= c %>"><%= c %></option>
      <% }) %>
    </select>

    <button onclick="updatePreview()"><i class="fas fa-eye"></i> Update Preview</button>
    <button onclick="downloadPDF()"><i class="fas fa-download"></i> Download PDF</button>
  </div>

  <!-- PREVIEW -->
  <div class="resume-preview classic" id="preview">
    <h2>John Doe</h2>
    <p>Email: john@example.com | Phone: +1234567890</p>
    <div class="section-title">Summary</div>
    <p>Brief about you...</p>
    <div class="section-title">Education</div>
    <p>Degree, Institution, Year...</p>
    <div class="section-title">Experience</div>
    <p>Company, Role, Duration</p>
    <div class="section-title">Skills</div>
    <p>JavaScript, Node.js, Photoshop</p>
  </div>
</main>

<footer>© <%= new Date().getFullYear() %> Wanpot — Built with ❤️ by Kharis Pro Tech</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
function toggleMenu(){document.querySelector('nav ul').classList.toggle('active');}

// Add dynamic input entries
function addEntry(listId){
  const list = document.getElementById(listId);
  const div = document.createElement('div');
  div.innerHTML = '<input type="text" placeholder="Add more...">';
  list.insertBefore(div,list.querySelector('button'));
}

// Update live preview
function updatePreview(){
  const preview = document.getElementById('preview');
  preview.className = 'resume-preview ' + document.getElementById('templateSelect').value;

  const color = document.getElementById('colorSelect').value;
  preview.querySelector('h2').style.color = color;
  preview.querySelectorAll('.section-title').forEach(el => el.style.color = color);

  preview.querySelector('h2').textContent = document.getElementById('fullName').value || "John Doe";
  preview.querySelector('p').textContent = `Email: ${document.getElementById('email').value || "john@example.com"} | Phone: ${document.getElementById('phone').value || "+1234567890"}`;

  preview.querySelectorAll('.section-title').forEach((section,i)=>{
    if(section.textContent==='Summary'){
      section.nextElementSibling.textContent = document.getElementById('summary').value || "Brief about you...";
    } else if(section.textContent==='Education'){
      const educationInputs = Array.from(document.querySelectorAll('#educationList input')).map(inp => inp.value).filter(v=>v);
      section.nextElementSibling.textContent = educationInputs.join('\n') || "Degree, Institution, Year...";
    } else if(section.textContent==='Experience'){
      const expInputs = Array.from(document.querySelectorAll('#experienceList input')).map(inp => inp.value).filter(v=>v);
      section.nextElementSibling.textContent = expInputs.join('\n') || "Company, Role, Duration";
    } else if(section.textContent==='Skills'){
      section.nextElementSibling.textContent = document.getElementById('skills').value || "JavaScript, Node.js, Photoshop";
    }
  });
}

// PDF download
async function downloadPDF(){
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({unit:'pt', format:'a4'});
  const preview = document.getElementById('preview');
  doc.html(preview,{callback:function(pdf){pdf.save('Resume.pdf');}, x:20, y:20, html2canvas:{scale:0.57}});
}
</script>
</body>
</html>
