<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
   <!-- iOS Home Screen Support -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Wanpot">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/images/wanpot.ico">

  <title>Wanpot - All-in-One Smart App</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="icon" href="/images/wanpot.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="manifest" href="/manifest.json">
</head>
<body>
  <header>
  <div class="navbar">
    <!-- LOGO SECTION -->
    <div class="logo">
      <a href="/dashboard"><img src="/images/wanpot.ico" alt="Wanpot Logo"></a>
      <span class="logo-text">Wanpot</span>
    </div>

    <!-- NAVIGATION -->
    <nav>
      <ul>
        <li><a href="/dashboard">Home</a></li>
        <li><a href="/dashboard#features">Features</a></li>
        <li><a href="/dashboard#about">About</a></li>
        <li><a href="#" onclick="installApp()">Download</a></li>
      </ul>
    </nav>

   <!-- USER + MENU -->
    <div style="display: flex; align-items: center; gap: 1rem;">

      <!-- USER PHOTO DROPDOWN -->
      <div class="user-menu">
        <img 
          src="<%= user.photo || '/images/wanpot.png' %>" 
          alt="User" 
          class="user-photo" 
          onclick="toggleDropdown()" 
        />

        <ul class="dropdown-menu">

          <li><a href="/profile">Profile</a></li>
          <li><a href="/settings">Settings</a></li>

          <% if (user.role === 'admin') { %>
            <li><a href="/admin">Administration</a></li>
          <% } %>

          <li><a href="/logout">Logout</a></li>

        </ul>
      </div>

      <!-- MENU TOGGLE FOR MOBILE -->
      <div class="menu-toggle" onclick="toggleMenu()">☰</div>

    </div>

  </div>
</header>


  <!-- HERO SECTION -->
  <!-- <section class="hero">
    <h1>Welcome to Wanpot - Your All-in-One Smart App</h1>
    <p>Manage your work, projects, and personal life seamlessly in one place.</p>
    <a href="#features" class="cta-btn">Get Started</a>
  </section> -->

  <script>
    // Toggle user dropdown
    function toggleDropdown() {
      const dropdown = document.querySelector('.dropdown-menu');
      dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
    }

    // Close dropdown if clicked outside
    window.onclick = function(event) {
      if (!event.target.matches('.user-photo')) {
        const dropdown = document.querySelector('.dropdown-menu');
        if (dropdown) dropdown.style.display = 'none';
      }
    }

    // Toggle nav menu for mobile
    function toggleMenu() {
      const nav = document.querySelector('nav ul');
      nav.classList.toggle('active');
    }
  </script>
    <script>
  let deferredPrompt;

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
  });

  function installApp() {
    const isIOS = /iphone|ipad|ipod/.test(navigator.userAgent.toLowerCase());
    const isInStandaloneMode = ('standalone' in window.navigator) && window.navigator.standalone;

    if (isIOS && !isInStandaloneMode) {
      alert('📱 Tap the "Share" icon at the bottom, then choose "Add to Home Screen" to install Wanpot.');
    } else if (deferredPrompt) {
      deferredPrompt.prompt();
      deferredPrompt.userChoice.then(choice => {
        if (choice.outcome === 'accepted') {
          alert('🎉 Wanpot added to your home screen!');
        }
        deferredPrompt = null;
      });
    } else {
      alert('💡 Use your browser’s “Install” or “Add to Home Screen” option to install Wanpot.');
    }
  }
</script>
</body>
</html>
