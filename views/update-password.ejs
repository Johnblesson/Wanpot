<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wanpot | Change Password</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
body {
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  color: #f8fafc;
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

.container {
  background: rgba(30, 41, 59, 0.95);
  padding: 40px;
  border-radius: 20px;
  max-width: 450px;
  width: 100%;
  box-shadow: 0 4px 20px rgba(0,0,0,0.5);
}

h2 {
  color: #38bdf8;
  text-align: center;
  margin-bottom: 30px;
}

form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.label-wrapper {
  display: flex;
  flex-direction: column;
  position: relative;
}

label {
  font-weight: 600;
  margin-bottom: 5px;
  display: block;
}

input[type="password"], input[type="text"] {
  padding: 12px 40px 12px 12px;
  border-radius: 8px;
  border: none;
  background: #1e293b;
  color: #f8fafc;
  width: 100%;
}

.toggle-password {
  position: absolute;
  right: 10px;
  top: 37px;
  cursor: pointer;
  color: #38bdf8;
}

button {
  padding: 12px;
  border-radius: 8px;
  border: none;
  background: #38bdf8;
  color: #fff;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

button:hover {
  background: #0ea5e9;
}

@media(max-width:480px){
  .container {
    padding: 30px 20px;
  }
}
</style>
</head>
<body>

<div class="container">
  <h2>Change Password</h2>
  <form action="/update-password/<%= users._id %>?_method=PATCH" method="post">
    
    <div class="label-wrapper">
      <label for="oldPassword">Old Password:</label>
      <input type="password" name="oldPassword" id="oldPassword" placeholder="Enter old password" required>
      <i class="fas fa-eye toggle-password" toggle="#oldPassword"></i>
    </div>
    
    <div class="label-wrapper">
      <label for="newPassword">New Password:</label>
      <input type="password" name="newPassword" id="newPassword" placeholder="Enter new password" required>
      <i class="fas fa-eye toggle-password" toggle="#newPassword"></i>
    </div>

    <input type="hidden" name="createdBy" value="<%= user.fullname %>">
    <input type="hidden" name="username" value="<%= user.username %>">

    <button type="submit">Update Password</button>
  </form>
</div>

<script>
// Show/Hide Password Toggle
document.querySelectorAll('.toggle-password').forEach(icon => {
  icon.addEventListener('click', () => {
    const input = document.querySelector(icon.getAttribute('toggle'));
    if (input.type === "password") {
      input.type = "text";
      icon.classList.remove('fa-eye');
      icon.classList.add('fa-eye-slash');
    } else {
      input.type = "password";
      icon.classList.remove('fa-eye-slash');
      icon.classList.add('fa-eye');
    }
  });
});
</script>

</body>
</html>
