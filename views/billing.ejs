<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Billing | WANPOT</title>
  <style>
    body {
      background: #0f172a;
      font-family: 'Poppins', sans-serif;
      color: #fff;
      padding: 40px;
    }

    .billing-box {
      max-width: 600px;
      margin: auto;
      background: #1e293b;
      padding: 30px;
      border-radius: 15px;
    }

    input {
      width: 100%;
      padding: 12px;
      margin: 10px 0;
      border-radius: 8px;
      border: none;
    }

    button {
      width: 100%;
      padding: 15px;
      margin-top: 10px;
      background: #10b981;
      border: none;
      color: #fff;
      border-radius: 8px;
      cursor: pointer;
      font-size: 1.1rem;
    }
    button:hover { background: #059669; }
  </style>
</head>
<body>

<div class="billing-box">
  <h2>Billing Information</h2>

  <form action="/billing/complete" method="POST">
    <label>Name on Card</label>
    <input type="text" required>

    <label>Card Number</label>
    <input type="text" maxlength="16" required>

    <label>Expiry Date</label>
    <input type="text" placeholder="MM/YY" required>

    <label>CVC</label>
    <input type="text" maxlength="3" required>

    <button type="submit">Pay & Activate</button>
  </form>
</div>

</body>
</html>
