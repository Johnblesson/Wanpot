<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WANPOT | Settings</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/settings.css">
</head>
<body>
  <!-- HEADER -->
  <header>
    <div class="navbar">
      <div class="logo">Wanpot</div>
      <nav>
        <ul>
          <li><a href="/dashboard">Home</a></li>
          <li><a href="/settings">Settings</a></li>
          <li><a href="/profile">Profile</a></li>
          <li><a href="/logout">Logout</a></li>
        </ul>
      </nav>
      <div style="display: flex; align-items: center;">
        <div class="user-menu">
          <img src="<%= user.photo || '/default-user.jpg' %>" alt="User" class="user-photo" onclick="toggleDropdown()">
          <ul class="dropdown-menu">
            <li><a href="#">Profile</a></li>
            <li><a href="/settings">Settings</a></li>
            <li><a href="/update-password/<%= user._id %>">Change Password</a></li>
          </ul>
        </div>
        <div class="menu-toggle" onclick="toggleMenu()">☰</div>
      </div>
    </div>
  </header>

  <h2 class="page-heading">Settings</h2>

  <div class="card-container">
    <a href="/update-profile/<%= user._id %>" class="card">Edit Profile</a>
    <a href="/update-password/<%= user._id %>" class="card">Change Password</a>
    <a href="#" class="card" onclick="redirectToFaq('<%= role %>')">Wanpot FAQ</a>
    <a href="/login-history" class="card">Devices</a>
    <a href="/logout" class="card">Logout</a>
  </div>

  <div class="two-factor-form">
    <h2>Two-Factor Authentication</h2>
    <form action="/2fa" method="POST">
      <label>
        <input type="radio" name="twoFactorAuth" value="enable" <%= user.twoFactorEnabled ? 'checked' : '' %>> Enable 2FA
      </label>
      <label>
        <input type="radio" name="twoFactorAuth" value="disable" <%= !user.twoFactorEnabled ? 'checked' : '' %>> Disable 2FA
      </label>
      <button type="submit">Save Changes</button>
    </form>
    <% if (user.twoFactorEnabled) { %>
      <p>2FA is currently <strong>enabled</strong>.</p>
    <% } else { %>
      <p>2FA is currently <strong>disabled</strong>.</p>
    <% } %>
  </div>

  <script>
    function redirectToFaq(role) {
      if (role === 'admin') {
        window.location.href = '/faq-admin';
      } else if (role === 'user') {
        window.location.href = '/faq';
      }
    }

    function toggleDropdown() {
      const dropdown = document.querySelector('.dropdown-menu');
      dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
    }

    function toggleMenu() {
      const nav = document.querySelector('nav ul');
      nav.classList.toggle('active');
    }

    window.onclick = function(event) {
      if (!event.target.matches('.user-photo')) {
        const dropdown = document.querySelector('.dropdown-menu');
        if (dropdown) dropdown.style.display = 'none';
      }
    }
  </script>
</body>
</html>
