<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wanpot | Note Keeper</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: #f8fafc;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      min-height: 100vh;
      margin: 0;
      padding: 2rem 1rem;
    }
    .note-container {
      width: 100%;
      max-width: 600px;
      background: rgba(255,255,255,0.05);
      border-radius: 15px;
      padding: 2rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }
    h1 {
      color: #38bdf8;
      text-align: center;
      margin-bottom: 1rem;
    }
    textarea {
      width: 90%;
      height: 120px;
      padding: 1rem;
      border-radius: 10px;
      border: none;
      background: rgba(255,255,255,0.1);
      color: #f8fafc;
      resize: none;
      margin-bottom: 1rem;
    }
    textarea::placeholder {
      color: #cbd5e1;
    }
    button {
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      border: none;
      padding: 0.8rem 1.5rem;
      border-radius: 8px;
      color: white;
      font-weight: 600;
      cursor: pointer;
      margin: 0.3rem;
      transition: transform 0.2s;
    }
    button:hover {
      transform: scale(1.05);
    }
    ul {
      list-style: none;
      padding: 0;
      margin-top: 1rem;
    }
    li {
      background: rgba(255,255,255,0.1);
      padding: 0.8rem 1rem;
      margin-bottom: 0.5rem;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    li span {
      flex: 1;
      margin-right: 0.5rem;
      word-break: break-word;
    }
    .note-actions button {
      background: rgba(255,255,255,0.15);
      color: #f8fafc;
      padding: 0.3rem 0.6rem;
      font-size: 0.9rem;
    }
    .note-actions button:hover {
      background: rgba(56,189,248,0.3);
    }
    @media (max-width: 480px) {
      .note-container {
        padding: 1rem;
      }
      textarea {
        height: 100px;
      }
      button {
        padding: 0.6rem 1rem;
        font-size: 0.9rem;
      }
    }
  </style>
</head>
<body>

  <div class="note-container">
    <h1>Note Keeper 📝</h1>
    <textarea id="note-input" placeholder="Write your note here..."></textarea>
    <div>
      <button id="add-note">Add Note</button>
      <button id="export-notes">Export JSON</button>
      <input type="file" id="import-notes" style="display:none;">
      <button onclick="document.getElementById('import-notes').click()">Import JSON</button>
    </div>
    <ul id="notes-list"></ul>
  </div>

  <script>
    let notes = [];

    const noteInput = document.getElementById('note-input');
    const addBtn = document.getElementById('add-note');
    const notesList = document.getElementById('notes-list');
    const exportBtn = document.getElementById('export-notes');
    const importInput = document.getElementById('import-notes');

    // Add a new note
    addBtn.addEventListener('click', () => {
      const text = noteInput.value.trim();
      if (!text) return alert("Enter a note first!");
      notes.push(text);
      noteInput.value = '';
      renderNotes();
    });

    // Render notes
    function renderNotes() {
      notesList.innerHTML = '';
      notes.forEach((note, index) => {
        const li = document.createElement('li');
        const span = document.createElement('span');
        span.textContent = note;
        const actions = document.createElement('div');
        actions.classList.add('note-actions');

        const editBtn = document.createElement('button');
        editBtn.textContent = 'Edit';
        editBtn.onclick = () => editNote(index);

        const delBtn = document.createElement('button');
        delBtn.textContent = 'Delete';
        delBtn.onclick = () => deleteNote(index);

        actions.appendChild(editBtn);
        actions.appendChild(delBtn);
        li.appendChild(span);
        li.appendChild(actions);
        notesList.appendChild(li);
      });
    }

    // Edit note
    function editNote(index) {
      const newText = prompt("Edit your note:", notes[index]);
      if (newText !== null) {
        notes[index] = newText.trim();
        renderNotes();
      }
    }

    // Delete note
    function deleteNote(index) {
      if (confirm("Are you sure you want to delete this note?")) {
        notes.splice(index, 1);
        renderNotes();
      }
    }

    // Export notes to JSON
    exportBtn.addEventListener('click', () => {
      if (notes.length === 0) return alert("No notes to export!");
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(notes));
      const a = document.createElement('a');
      a.href = dataStr;
      a.download = "notes.json";
      a.click();
    });

    // Import notes from JSON
    importInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const importedNotes = JSON.parse(event.target.result);
          if (Array.isArray(importedNotes)) {
            notes = importedNotes;
            renderNotes();
          } else {
            alert("Invalid JSON file.");
          }
        } catch(err) {
          alert("Failed to parse JSON.");
        }
      }
      reader.readAsText(file);
    });

    // Initial render
    renderNotes();
  </script>

</body>
</html>
