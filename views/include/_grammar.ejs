  <style>
    /* ===========================
   BASE / MOBILE FIRST
   =========================== */

.container {
  width: 95%;
  max-width: 1000px;
  margin: 105px auto 80px;
  background: rgba(255,255,255,0.04);
  padding: 1.4rem;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.06);
  box-shadow: 0 10px 30px rgba(6,182,212,0.08);
}

.ai-title {
  display: flex;
  align-items: center;      /* Vertically center icon and text */
  justify-content: center;  /* Horizontally center the whole block */
  gap: 10px;                /* Space between icon and text */
  font-size: 1.5rem;
  font-weight: 600;
  color: #38bdf8;
  margin-bottom: 1rem;
}
.ai-title i {
  font-size: 1.8rem;       /* Adjust icon size */
}


.text-input {
  width: 100%;
  min-height: 120px;
  padding: 12px 14px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(0,0,0,0.25);
  color: #e2e8f0;
  font-size: 1rem;
  resize: vertical;
}

.run-btn {
  margin-top: 12px;
  width: 100%;
  padding: 12px;
  border-radius: 12px;
  border: none;
  background: linear-gradient(90deg,#3b82f6,#06b6d4);
  color: #fff;
  font-weight: 700;
  cursor: pointer;
}

.loader {
  display: none;
  margin-top: 12px;
  color: #38bdf8;
  text-align: center;
}

.result-wrap {
  margin-top: 16px;
  display: flex;
  gap: 16px;
  flex-direction: column;
}

.result {
  background: rgba(0,0,0,0.3);
  padding: 14px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.05);
  white-space: pre-wrap;
  line-height: 1.6;
  color: #e6f7ff;
  max-height: 50vh; /* mobile first */
  overflow: auto;
}

.controls {
  display: flex;
  flex-direction: column; /* stacked on mobile */
  gap: 8px;
  justify-content: flex-start;
  margin-top: 6px;
}

.controls .btn {
  width: 100%; /* full width on mobile */
  padding: 8px 12px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  font-weight: 600;
}

.btn.copy {
  background: #38bdf8;
  color: #000;
}

.btn.download {
  background: #06b6d4;
  color: #fff;
}

/* ===========================
   MEDIA QUERIES
   =========================== */

/* Tablets & up (≥ 480px) */
@media (min-width: 480px) {
  .ai-title {
    flex-direction: row; /* icon + title side-by-side */
    align-items: center;
    gap: 12px;
    font-size: 1.5rem;
  }

  .controls {
    flex-direction: row; /* buttons side-by-side */
    justify-content: flex-end;
  }

  .controls .btn {
    width: auto; /* reset width */
  }

  .result {
    max-height: 55vh;
  }
}

/* Medium screens (≥ 768px) */
@media (min-width: 768px) {
  .container {
    padding: 1.8rem;
  }

  .result {
    max-height: 60vh;
  }
}

/* Large screens (≥ 1024px) */
@media (min-width: 1024px) {
  .container {
    max-width: 1200px;
  }

  .result {
    max-height: 65vh;
  }
}


 .clear-btn {
    margin-top: 0.5rem;
    padding: 0.5rem 1rem;
    background: #ef4444;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: 0.2s;
  }
  .clear-btn:hover {
    background: #dc2626;
  }

  </style>


  <main class="container">
    <div class="ai-title"><i class="fas fa-spell-check"></i> AI Grammar & Proofreading</div>
    <p style="color:#cbd5e1; margin-bottom:12px">
      Enter your text below and Wanpot AI will correct spelling, grammar, and style while improving clarity and readability.
    </p>

    <textarea id="textInput" class="text-input" placeholder="Paste your text here..."></textarea>
    <button id="generateBtn" class="run-btn">Correct & Enhance</button>
    <div class="loader" id="loader">⏳ Processing your text...</div>

    <div class="result-wrap" id="resultWrap" style="display:none;">
      <div class="controls">
        <button class="btn copy" id="copyBtn"><i class="fas fa-copy"></i> Copy</button>
        <button class="btn download" id="downloadBtn"><i class="fas fa-download"></i> Download .txt</button>
      </div>
      <div id="result" class="result" aria-live="polite"></div>
    </div>

      <section class="grammar-history">
      <h3>Your Previous Corrections</h3>
      <div id="historyContainer" style="max-height:200px; overflow-y:auto; background: rgba(255,255,255,0.05); border-radius:10px; padding:10px;">
        <!-- History entries will appear here -->
      </div>
      <button class="clear-btn" id="clearHistoryBtn">
        <i class="fas fa-trash"></i> Clear History
      </button>
    </section>

  </main>
<script>

  const textInput = document.getElementById("textInput");
  const generateBtn = document.getElementById("generateBtn");
  const loader = document.getElementById("loader");
  const resultWrap = document.getElementById("resultWrap");
  const resultEl = document.getElementById("result");
  const copyBtn = document.getElementById("copyBtn");
  const downloadBtn = document.getElementById("downloadBtn");
  const historyContainer = document.getElementById('historyContainer');
  const clearHistoryBtn = document.getElementById('clearHistoryBtn');

  // Generate corrected text
  generateBtn.addEventListener("click", async () => {
    const text = textInput.value.trim();
    if (!text) { alert("Please enter some text."); return; }

    loader.style.display = "block";
    resultWrap.style.display = "none";
    resultEl.textContent = "";

    try {
      const res = await fetch("/ai/grammar/run", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text })
      });

      const data = await res.json();
      loader.style.display = "none";

      if (data.error) { alert("Error: " + data.error); return; }

      const corrected = data.corrected || "No output.";
      resultEl.textContent = corrected;
      resultWrap.style.display = "block";
      resultWrap.scrollIntoView({ behavior: "smooth", block: "center" });

      saveToLocalHistory(text, corrected); // Save to local history

    } catch(err) {
      loader.style.display = "none";
      alert("Network error. Try again.");
      console.error(err);
    }
  });

  // Copy corrected text
  copyBtn.addEventListener("click", () => {
    navigator.clipboard.writeText(resultEl.innerText).then(() => {
      copyBtn.innerText = "Copied!";
      setTimeout(() => copyBtn.innerText = "Copy", 1400);
    });
  });

  // Download corrected text
  downloadBtn.addEventListener("click", () => {
    const blob = new Blob([resultEl.innerText], { type:"text/plain" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `CorrectedText_${Date.now()}.txt`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Save a correction to local history
  function saveToLocalHistory(inputText, correctedText) {
    const history = JSON.parse(localStorage.getItem('grammarHistory') || '[]');
    history.unshift({ input: inputText, corrected: correctedText, timestamp: new Date().toISOString() });
    localStorage.setItem('grammarHistory', JSON.stringify(history));
    renderHistory();
  }

  // Render history
  function renderHistory() {
    const history = JSON.parse(localStorage.getItem('grammarHistory') || '[]');
    historyContainer.innerHTML = '';

    if (history.length === 0) {
      historyContainer.innerHTML = '<p style="color:#94a3b8;">No history yet. Start correcting text!</p>';
      return;
    }

    history.forEach(entry => {
      const div = document.createElement('div');
      div.style.marginBottom = '10px';
      div.style.padding = '8px';
      div.style.background = 'rgba(56,189,248,0.05)';
      div.style.borderRadius = '8px';
      div.innerHTML = `
        <strong>Input:</strong> ${entry.input}<br>
        <strong>Corrected:</strong> ${entry.corrected}<br>
        <small style="color:#94a3b8;">${new Date(entry.timestamp).toLocaleString()}</small>
      `;
      historyContainer.appendChild(div);
    });
  }

  // Clear local history
  clearHistoryBtn.addEventListener('click', () => {
    if(!confirm("Are you sure you want to clear your grammar history?")) return;
    localStorage.removeItem('grammarHistory');
    renderHistory();
  });

  // Load history on page load
  window.addEventListener('DOMContentLoaded', renderHistory);
</script>


</body>
</html>
