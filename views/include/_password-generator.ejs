
<link rel="stylesheet" href="/css/vault.css">
<main class="app-container">
  <div class="card">
    <div style="display:flex; justify-content:space-between; gap:1rem; align-items:start; margin-bottom:1rem;">
      <div>
        <h1>Secure Password Generator</h1>
        <div class="lead">Create strong passwords and store them safely in your database.</div>
      </div>

      <div style="display:flex; gap:0.4rem;">
        <button class="btn" id="generateBtn"><i class="fa-solid fa-shield-halved"></i> Generate</button>
        <button class="btn ghost" id="copyBtn"><i class="fa-regular fa-clipboard"></i> Copy</button>
      </div>
    </div>

    <div class="grid">

      <!-- LEFT CONTROLS -->
      <section class="controls">

        <div class="control-group">
          <div class="preview">
            <div class="password-box" id="passwordBox">•••••••••••••••••</div>

            <div style="display:flex; justify-content:space-between;">
              <div class="strength-wrap">
                <div class="meter">
                  <div class="meter-fill" id="meterFill"></div>
                </div>
                <div class="strength-label" id="strengthLabel">Strength: —</div>
              </div>

              <div class="small">Length: <strong id="lenLabel">16</strong></div>
            </div>
          </div>
        </div>

        <div class="control-group">
          <div class="row">
            <label class="small">Password Length</label>
            <input type="range" id="lengthRange" min="6" max="128" value="16" />
          </div>
        </div>

        <div class="control-group toggles">
          <div class="toggle"><span>Include lowercase</span><input type="checkbox" id="lowercase" checked></div>
          <div class="toggle"><span>Include uppercase</span><input type="checkbox" id="uppercase" checked></div>
          <div class="toggle"><span>Include numbers</span><input type="checkbox" id="numbers" checked></div>
          <div class="toggle"><span>Include symbols</span><input type="checkbox" id="symbols" checked></div>
          <div class="toggle"><span>Exclude ambiguous</span><input type="checkbox" id="excludeAmb" checked></div>
        </div>

        <div class="control-group" style="display:flex; gap:0.6rem; flex-wrap:wrap;">
          <button class="btn" id="downloadBtn"><i class="fa-solid fa-file-arrow-down"></i> Download</button>
          <button class="btn ghost" id="saveBtn"><i class="fa-solid fa-bookmark"></i> Save to DB</button>
        </div>

      </section>

      <!-- RIGHT — DATABASE VAULT -->
      <aside class="aside">
        <div class="card">
          <h3>🔐 Saved Passwords (Database)</h3>
          <div class="vault-list" id="vaultList">
            <div class="small">Loading...</div>
          </div>
        </div>
      </aside>

    </div>
  </div>
</main>

<script src="/js/vault.js"></script>

