
<link rel="stylesheet" href="/css/code-explainer.css">


<div class="code-helper-container">

  <div class="ai-title">
    <i class="fas fa-lightbulb"></i>
    AI Code Explainer
  </div>

  <p class="about-wanpot">
  Wanpot AI Code Explainer helps you understand any code instantly.  
  Paste your snippet, and the AI will break it down beautifully with syntax highlighting.
</p>

  <!-- Example Code -->
  <button class="example-btn" id="exampleBtn">
    <i class="fas fa-code"></i> Try Example Code
  </button>

  <!-- Input -->
  <textarea id="prompt" class="prompt-input" placeholder="Paste your code snippet here..."></textarea>

  <!-- Run -->
  <button class="run-btn" id="runExplainer">Explain Code</button>

  <div class="loader" id="loader">⏳ AI is thinking...</div>

  <!-- Side-by-side Result -->
<div class="side-by-side" id="sideBySide">

  <div class="pane code-pane resizable" id="codePane">
    <div class="resize-handle"></div>
    <h4>Your Code</h4>
    <pre><code id="codeInputPreview"></code></pre>
  </div>

  <div class="pane explanation-pane resizable" id="explanationPane">
    <div class="resize-handle"></div>
    <h4>AI Explanation</h4>
    <pre><code id="sideBySideResponse"></code></pre>

    <button class="copy-btn" id="copyBtn">Copy</button>
    <button class="download-btn" id="downloadTxt">Download .txt</button>
    <button class="float-btn" id="floatBtn">Float Window</button>
  </div>

</div>

</div>

<script>
  const promptBox = document.getElementById("prompt");
  const loader = document.getElementById("loader");
  const sideBySide = document.getElementById("sideBySide");

  /* Auto expand textarea */
  promptBox.addEventListener("input", () => {
    promptBox.style.height = "auto";
    promptBox.style.height = promptBox.scrollHeight + "px";
  });

  /* Example Fill */
  document.getElementById("exampleBtn").addEventListener("click", () => {
    const sample = `
function greet(name) {
  return "Hello " + name;
}
console.log(greet("Wanpot User"));
`;
    promptBox.value = sample;
    promptBox.dispatchEvent(new Event("input"));
  });

  /* Run Explainer */
  document.getElementById("runExplainer").addEventListener("click", async () => {
    const codeSnippet = promptBox.value.trim();
    if (!codeSnippet) return;

    loader.style.display = "block";
    sideBySide.style.display = "none";

    try {
      const res = await fetch("/ai/code-explainer/run", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ codeSnippet })
      });

      const data = await res.json();
      loader.style.display = "none";

      document.getElementById("codeInputPreview").innerText = codeSnippet;
      document.getElementById("sideBySideResponse").innerText =
        data.error ? "❌ " + data.error : data.response;

      sideBySide.style.display = "flex";
      Prism.highlightAll();

    } catch (err) {
      loader.style.display = "none";
      alert("Network or server error!");
    }
  });

  /* Copy Explanation */
  document.addEventListener("click", (e) => {
    if (e.target.id === "copyBtn") {
      const text = document.getElementById("sideBySideResponse").innerText;
      navigator.clipboard.writeText(text);
      e.target.innerText = "Copied!";
      setTimeout(() => e.target.innerText = "Copy", 1500);
    }
  });
</script>

<script>
/* ===========================================================
    1. RESIZABLE PANELS
=========================================================== */
document.querySelectorAll('.resizable').forEach(pane => {
  const handle = pane.querySelector('.resize-handle');
  let isResizing = false;

  handle.addEventListener('mousedown', e => {
    isResizing = true;
    document.body.style.userSelect = "none";
  });

  document.addEventListener('mousemove', e => {
    if (!isResizing) return;
    pane.style.flex = 'none';
    pane.style.width = e.clientX - pane.getBoundingClientRect().left + 'px';
  });

  document.addEventListener('mouseup', () => {
    isResizing = false;
    document.body.style.userSelect = "auto";
  });
});


/* ===========================================================
    2. DOWNLOAD EXPLANATION AS .TXT
=========================================================== */
document.getElementById("downloadTxt").addEventListener("click", () => {
  const text = document.getElementById("sideBySideResponse").innerText;
  const blob = new Blob([text], { type: "text/plain" });
  const url = URL.createObjectURL(blob);

  const a = document.createElement("a");
  a.href = url;
  a.download = "ai-explanation.txt";
  a.click();

  URL.revokeObjectURL(url);
});


/* ===========================================================
    3. FLOATING RESULT PANEL
=========================================================== */
const floatBtn = document.getElementById("floatBtn");
const floatingWindow = document.getElementById("floatingWindow");
const floatingContent = document.getElementById("floatingContent");
const closeFloat = document.getElementById("closeFloating");

floatBtn.addEventListener("click", () => {
  floatingContent.innerText =
    document.getElementById("sideBySideResponse").innerText;

  floatingWindow.style.display = "block";
});

closeFloat.addEventListener("click", () => {
  floatingWindow.style.display = "none";
});


/* Make floating window draggable */
let offsetX, offsetY, isDragging = false;

const header = document.querySelector('.floating-header');

header.addEventListener('mousedown', (e) => {
  isDragging = true;
  offsetX = e.clientX - floatingWindow.offsetLeft;
  offsetY = e.clientY - floatingWindow.offsetTop;
});

document.addEventListener('mousemove', (e) => {
  if (!isDragging) return;
  floatingWindow.style.left = (e.clientX - offsetX) + "px";
  floatingWindow.style.top = (e.clientY - offsetY) + "px";
});

document.addEventListener('mouseup', () => {
  isDragging = false;
});
</script>



<div id="floatingWindow" class="floating-window">
  <div class="floating-header">
    <span>AI Explanation</span>
    <button id="closeFloating">✖</button>
  </div>

  <pre><code id="floatingContent"></code></pre>
</div>

