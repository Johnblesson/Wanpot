<!-- views/features/emailComposer.ejs -->
<style>
main {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
  padding: 2rem;
  max-width: 1200px;
  margin: auto;
  margin-top: 85px;
}

.ec-form, .ec-history {
  flex: 1;
  min-width: 320px;
  background: rgba(255,255,255,0.05);
  padding: 1.8rem;
  border-radius: 15px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}

h2 { color:#38bdf8; margin-top:0; }

input, textarea {
  width: 100%;
  padding: 1rem;
  margin-bottom: 1rem;
  border-radius: 10px;
  border: none;
  background: rgba(255,255,255,0.1);
  color: #fff;
}

button {
  background: linear-gradient(90deg,#3b82f6,#06b6d4);
  border: none;
  padding: 0.9rem 1.6rem;
  border-radius: 8px;
  color: #fff;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s;
  margin-right: 0.5rem;
}

button:hover { transform: scale(1.05); }

.history-item {
  background: rgba(255,255,255,0.05);
  padding: 1rem;
  margin-bottom: 1rem;
  border-radius: 10px;
}

.prompt {
  font-weight: 700;
  color: #f59e0b;
  margin-bottom: 0.4rem;
}

.response { white-space: pre-line; }

.date {
  margin-top: 0.3rem;
  font-size: 0.8rem;
  color: #94a3b8;
}
</style>
<main>
 <div class="ec-form">
  <h2>Smart Email Composer</h2>
  <p style="color:#94a3b8; margin-bottom:1rem;">
    Quickly draft professional emails with AI suggestions. Enter subject and content below.
  </p>

  <input id="emailSubject" placeholder="Email Subject" />
  <textarea id="emailBody" placeholder="Email Body"></textarea>

  <button onclick="generateEmail()"><i class="fas fa-paper-plane"></i> Generate Email</button>
  <button onclick="clearHistory()"><i class="fas fa-trash"></i> Clear History</button>
</div>


  <div class="ec-history" id="history">
    <% history.forEach(h => { %>
      <div class="history-item">
        <div class="prompt">Subject:</div>
        <div class="response"><%= h.subject %></div>
        <div class="prompt">Body:</div>
        <div class="response"><%= h.body %></div>
        <hr style="border-color:#333">
        <div class="prompt">AI Suggestion:</div>
        <div class="response" id="ai-<%= h._id %>"><%= h.aiSuggestion %></div>
        <button onclick="copyText('<%= h._id %>')"><i class="fas fa-copy"></i> Copy</button>
        <button onclick="downloadText('<%= h._id %>')"><i class="fas fa-download"></i> Download</button>
        <div class="date"><%= new Date(h.createdAt).toLocaleString() %></div>
      </div>
    <% }) %>
  </div>
</main>

<script>
async function generateEmail(){
  const subject = document.getElementById("emailSubject").value.trim();
  const body = document.getElementById("emailBody").value.trim();
  if(!subject && !body) return alert("Please provide subject or body.");

  const res = await fetch("/ai/email-composer/compose", {
    method: "POST",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify({ subject, body })
  });

  const data = await res.json();
  if(!data.success) return alert("Error: " + data.error);

  updateHistory(data.history);
  document.getElementById("emailSubject").value = '';
  document.getElementById("emailBody").value = '';
}

function updateHistory(history){
  const hDiv = document.getElementById("history");
  hDiv.innerHTML = "";
  history.forEach(h=>{
    const div = document.createElement("div");
    div.className = "history-item";
    div.innerHTML = `
      <div class="prompt">Subject:</div>
      <div class="response">${h.subject}</div>
      <div class="prompt">Body:</div>
      <div class="response">${h.body}</div>
      <hr style="border-color:#333">
      <div class="prompt">AI Suggestion:</div>
      <div class="response" id="ai-${h._id}">${h.aiSuggestion}</div>
      <button onclick="copyText('${h._id}')"><i class="fas fa-copy"></i> Copy</button>
      <button onclick="downloadText('${h._id}')"><i class="fas fa-download"></i> Download</button>
      <div class="date">${new Date(h.createdAt).toLocaleString()}</div>
    `;
    hDiv.appendChild(div);
  });
}

function copyText(id){
  const text = document.getElementById(`ai-${id}`).innerText;
  navigator.clipboard.writeText(text).then(()=> alert("Copied to clipboard!"));
}

function downloadText(id){
  const text = document.getElementById(`ai-${id}`).innerText;
  const blob = new Blob([text], { type: "text/plain" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "ai_email.txt";
  a.click();
  URL.revokeObjectURL(url);
}

async function clearHistory(){
  const res = await fetch("/ai/email-composer/clear",{ method:"POST" });
  if(res.ok) document.getElementById("history").innerHTML = "";
}
</script>
