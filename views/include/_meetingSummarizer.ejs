<style>
    /* ===========================
   WANPOT AI MEETING SUMMARIZER
   =========================== */

.container {
  width: 92%;
  max-width: 900px;
  margin: 100px auto 50px;
  background: rgba(255,255,255,0.06);
  padding: 1.6rem;
  border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.1);
  backdrop-filter: blur(12px);
  box-shadow: 0 0 35px rgba(6,182,212,0.2);
  animation: fadeIn 0.8s ease;
}

h1 {
  color: var(--accent1);
  font-size: 1.8rem;
  margin-bottom: 0.5rem;
}

.container p {
  color: var(--muted);
  margin-bottom: 1rem;
}

.text-input {
  width: 100%;
  min-height: 140px;
  padding: 1rem;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(0,0,0,0.3);
  color: #e6f7ff;
  font-size: 1rem;
  resize: vertical;
  outline: none;
  transition: 0.3s all;
}

.text-input:focus {
  border-color: var(--accent1);
  box-shadow: 0 0 10px rgba(6,182,212,0.4);
}

.run-btn {
  margin-top: 12px;
  width: 100%;
  padding: 12px;
  border-radius: 12px;
  border: none;
  background: linear-gradient(90deg, var(--accent2), var(--accent1));
  color: #fff;
  font-weight: 700;
  cursor: pointer;
  transition: 0.3s all;
}

.run-btn:hover {
  opacity: 0.9;
}

.result-wrap {
  margin-top: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.result {
  background: rgba(0,0,0,0.35);
  padding: 14px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.06);
  white-space: pre-wrap;
  line-height: 1.6;
  color: #e6f7ff;
  max-height: 60vh;
  overflow: auto;
}

.controls {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  margin-top: 6px;
}

.btn {
  padding: 8px 12px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  font-weight: 600;
  transition: 0.3s all;
}

.btn.copy {
  background: var(--accent1);
  color: #000;
}

.btn.download {
  background: var(--accent2);
  color: #fff;
}

/* ===========================
   MOBILE FIRST
   =========================== */
@media(max-width: 768px) {
  h1 { font-size: 1.5rem; }
  .text-input { min-height: 120px; }
  .result { max-height: 50vh; }
  .controls { flex-direction: column; align-items: stretch; }
  .btn { width: 100%; }
}

@media(min-width: 768px) {
  .controls { flex-direction: row; justify-content: flex-end; }
  .btn { width: auto; }
}

@media(min-width: 1024px) {
  .container { max-width: 1050px; }
  .result { max-height: 55vh; }
}

</style>
  <div class="container">
    <h1>AI Meeting Summarizer</h1>
    <p>Convert meeting transcripts into concise summaries instantly.</p>

    <% if (error) { %>
      <div style="color:red; margin-bottom:12px;"><%= error %></div>
    <% } %>

    <form action="/ai/meeting-summarizer" method="POST">
      <textarea name="transcript" class="text-input" placeholder="Paste your meeting transcript here..."><%= transcript %></textarea>
      <button type="submit" class="run-btn">Generate Summary</button>
    </form>

    <% if (summary) { %>
      <div class="result-wrap">
        <h3>Summary:</h3>
        <div class="result"><%= summary %></div>
      </div>
    <% } %>
  </div>

