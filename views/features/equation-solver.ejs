<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Wanpot | Advanced Equation Solver</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js"></script>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  color: #f8fafc;
  overflow-x: hidden;
}

header {
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 100;
  background: rgba(15, 23, 42, 0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.navbar {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

/* LOGO SECTION */
.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo img {
  height: 40px;
  width: 40px;
  border-radius: 50%;
  object-fit: cover;
}

.logo-text {
  font-size: 1.5rem;
  font-weight: 700;
  background: linear-gradient(90deg, #3b82f6, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

nav ul { 
  list-style: none; 
  display: flex; 
  gap: 1.5rem; 
  flex-wrap: wrap;
}

nav ul li a { text-decoration: none; color: #f1f5f9; font-weight: 500; transition: color 0.3s; }
nav ul li a:hover { color: #38bdf8; }

.menu-toggle { display: none; font-size: 1.8rem; cursor: pointer; color: #fff; }

main { padding: 6rem 2rem 2rem; max-width: 900px; margin: auto; }

h1 { text-align: center; margin-bottom: 2rem; color: #38bdf8; font-size: 2rem; }

.solver-container {
  background: rgba(255,255,255,0.05);
  padding: 2rem;
  border-radius: 15px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}

.solver-container label { display: block; margin-bottom: 0.5rem; font-weight: 600; }

.solver-container input, .solver-container textarea {
  width: 100%;
  padding: 0.8rem 1rem;
  border-radius: 8px;
  border: none;
  margin-bottom: 1rem;
  background: rgba(255,255,255,0.1);
  color: #f8fafc;
  font-size: 1rem;
}

.solver-container button {
  background: linear-gradient(90deg, #3b82f6, #06b6d4);
  border: none;
  padding: 0.8rem 1.5rem;
  border-radius: 8px;
  color: #fff;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.2s;
  margin: 0.3rem 0.3rem 0.3rem 0;
}

.solver-container button:hover { transform: scale(1.05); }

.result {
  margin-top: 1.5rem;
  background: rgba(255,255,255,0.08);
  padding: 1rem;
  border-radius: 8px;
  font-family: monospace;
  white-space: pre-wrap;
  color: #cbd5e1;
  max-height: 400px;
  overflow-y: auto;
}

video#scanner { width: 100%; border-radius: 15px; margin-top: 1rem; }

footer {
  text-align: center;
  padding: 2rem 1rem;
  background: #0f172a;
  color: #64748b;
  font-size: 0.9rem;
  margin-top: 3rem;
}

@media (max-width: 768px) {
  nav ul { display: none; flex-direction: column; position: absolute; right: 20px; top: 70px; background: rgba(15,23,42,0.9); border-radius: 10px; padding: 1rem; }
  nav ul.active { display: flex; }
  .menu-toggle { display: block; }
  main { padding: 6rem 1rem 2rem; }
  .solver-container button { width: 100%; }
}
</style>
</head>
<body>
<header>
  <div class="navbar">
    <!-- LOGO SECTION -->
    <div class="logo">
      <img src="/images/wanpot.ico" alt="Wanpot Logo">
      <span class="logo-text">Wanpot</span>
    </div>
    <!-- <div class="logo">Wanpot</div> -->
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/">Features</a></li>
        <li><a href="/">About</a></li>
      </ul>
    </nav>
    <div class="menu-toggle" onclick="toggleMenu()">☰</div>
  </div>
</header>

<main>
  <h1>Advanced Equation Solver (Math AI)</h1>
  <div class="solver-container">

    <form id="solveForm" action="/equation" method="POST">
      <label for="equation">Enter your equation:</label>
      <input type="text" id="equation" name="equation" value="<%= equation %>" placeholder="e.g., 2x^2 + 3x - 5 = 0" required />
      <button type="submit"><i class="fa-solid fa-calculator"></i> Solve Equation</button>
    </form>

    <% if (error) { %>
      <div class="result" style="color:#f87171;"><strong>Error:</strong> <%= error %></div>
    <% } %>

    <% if (result) { %>
      <div class="result">
        <h3>Solution:</h3>
        <pre><%= result %></pre>

        <% if (steps && steps.length > 0) { %>
          <h3 style="margin-top:1rem;">Step-by-Step Derivation:</h3>
          <% steps.forEach((step, index) => { %>
            <p><strong>Step <%= index + 1 %>:</strong> <%= step %></p>
          <% }) %>
        <% } %>
      </div>
    <% } %>

    <hr style="margin: 1.5rem 0; border-color: rgba(255,255,255,0.2);" />

    <label>Scan Equation via Camera:</label>
    <video id="scanner" autoplay></video><br>
    <button id="startScan"><i class="fa-solid fa-camera"></i> Start Scanner</button>
    <button id="stopScan"><i class="fa-solid fa-stop"></i> Stop Scanner</button>

    <form id="uploadForm" action="/scan" method="POST" enctype="multipart/form-data" style="margin-top:1rem;">
      <input type="file" name="equationImage" accept="image/*" />
      <button type="submit"><i class="fa-solid fa-upload"></i> Upload & Extract Equation</button>
    </form>

  </div>
</main>

<footer>
  <p>© 2025 Wanpot | Built with ❤️ in Sierra Leone by <strong>Kharis Pro Tech</strong></p>
</footer>

<script>
function toggleMenu() { document.querySelector('nav ul').classList.toggle('active'); }

let stream;

document.getElementById("startScan").addEventListener("click", async (e) => {
  e.preventDefault();
  try {
    stream = await navigator.mediaDevices.getUserMedia({ video: true });
    const video = document.getElementById("scanner");
    video.srcObject = stream;
  } catch (err) {
    alert("Camera not accessible.");
  }
});

document.getElementById("stopScan").addEventListener("click", (e) => {
  e.preventDefault();
  if (stream) {
    stream.getTracks().forEach(track => track.stop());
    alert("Camera stopped.");
  }
});
</script>
</body>
</html>
 