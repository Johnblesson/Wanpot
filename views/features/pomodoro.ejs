<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wanpot - Pomodoro Timer</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="icon" href="/images/wanpot.ico" type="image/x-icon">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: #f8fafc;
      overflow-x: hidden;
    }

    header {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 100;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .navbar {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.7rem;
      font-weight: 700;
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 1.5rem;
    }

    nav ul li a {
      text-decoration: none;
      color: #f1f5f9;
      font-weight: 500;
      transition: color 0.3s;
    }

    nav ul li a:hover {
      color: #38bdf8;
    }

    .menu-toggle {
      display: none;
      font-size: 1.8rem;
      cursor: pointer;
      color: #fff;
    }

    .container {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 2rem 1rem;
      background: radial-gradient(circle at 30% 50%, rgba(59,130,246,0.3), transparent 70%),
                  radial-gradient(circle at 70% 60%, rgba(6,182,212,0.3), transparent 70%);
    }

    h1 {
      font-size: 2.3rem;
      margin-bottom: 1rem;
      color: #38bdf8;
    }

    #timer {
      font-size: 5rem;
      margin: 1rem 0;
      font-weight: 600;
    }

    #modeText {
      margin-bottom: 1.5rem;
      font-size: 1.2rem;
      color: #cbd5e1;
    }

    .controls {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
    }

    button {
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      border: none;
      color: white;
      font-weight: 600;
      padding: 0.8rem 1.6rem;
      border-radius: 50px;
      cursor: pointer;
      transition: 0.3s;
    }

    button:hover {
      transform: scale(1.05);
      box-shadow: 0 5px 20px rgba(6,182,212,0.4);
    }

    .settings {
      margin-top: 2rem;
      color: #cbd5e1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .settings input {
      width: 80px;
      padding: 0.3rem;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 5px;
      background: rgba(255,255,255,0.05);
      color: #f8fafc;
      text-align: center;
    }

    /* MODAL */
    .modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.6);
      z-index: 999;
    }

    .modal-content {
      background: rgba(15,23,42,0.95);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 2rem;
      text-align: center;
      max-width: 350px;
      box-shadow: 0 0 20px rgba(6,182,212,0.4);
      animation: popUp 0.4s ease;
    }

    @keyframes popUp {
      from { transform: scale(0.7); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .modal-content h3 {
      color: #38bdf8;
      margin-bottom: 1rem;
    }

    .modal-content p {
      color: #e2e8f0;
      margin-bottom: 1.5rem;
    }

    .modal-content button {
      background: linear-gradient(90deg, #06b6d4, #3b82f6);
    }

    /* ABOUT */
    .about {
      text-align: center;
      background: linear-gradient(90deg, #1e3a8a, #2563eb);
      padding: 3rem 1rem;
      border-top: 1px solid rgba(255,255,255,0.1);
      color: #f8fafc;
    }

    .about h2 {
      margin-bottom: 1rem;
    }

    footer {
      text-align: center;
      padding: 2rem 1rem;
      background: #0f172a;
      color: #64748b;
      font-size: 0.9rem;
    }

    @media (max-width: 768px) {
      nav ul {
        display: none;
        flex-direction: column;
        position: absolute;
        right: 20px;
        top: 70px;
        width: 200px;
        background: rgba(15,23,42,0.9);
        border-radius: 10px;
        padding: 1rem;
      }

      nav ul.active {
        display: flex;
      }

      .menu-toggle {
        display: block;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="navbar">
      <div class="logo">Wanpot</div>
      <nav>
        <ul>
          <li><a href="index.html#home">Home</a></li>
          <li><a href="index.html#features">Features</a></li>
          <li><a href="index.html#about">About</a></li>
        </ul>
      </nav>
      <div class="menu-toggle" onclick="toggleMenu()">☰</div>
    </div>
  </header>

  <section class="container">
    <h1>Pomodoro Timer ⏱️</h1>
    <div id="timer">25:00</div>
    <p id="modeText">Focus Mode 🔥</p>

    <div class="controls">
      <button id="start">Start</button>
      <button id="pause">Pause</button>
      <button id="reset">Reset</button>
    </div>

    <div class="settings">
      <label>Work (mins): <input type="number" id="workTime" value="25" min="1"></label>
      <label>Break (mins): <input type="number" id="breakTime" value="5" min="1"></label>
    </div>
  </section>

  <section class="about">
    <h2>Why Pomodoro?</h2>
    <p>The Pomodoro technique boosts focus by splitting work into timed sessions with short breaks in between. Wanpot helps you stay sharp, productive, and stress-free while you study or work!</p>
  </section>

  <footer>
    <p>© 2025 Wanpot | Built with ❤️ in Sierra Leone by <strong>Kharis Pro Tech</strong></p>
  </footer>

  <!-- Modal Popup -->
  <div class="modal" id="alertModal">
    <div class="modal-content">
      <h3 id="modalTitle">Time’s Up!</h3>
      <p id="modalMessage">Take a short break ☕</p>
      <button onclick="closeModal()">OK</button>
    </div>
  </div>

  <script>
    function toggleMenu() {
      document.querySelector('nav ul').classList.toggle('active');
    }

    const timerDisplay = document.getElementById('timer');
    const startBtn = document.getElementById('start');
    const pauseBtn = document.getElementById('pause');
    const resetBtn = document.getElementById('reset');
    const modeText = document.getElementById('modeText');
    const workInput = document.getElementById('workTime');
    const breakInput = document.getElementById('breakTime');
    const modal = document.getElementById('alertModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalMessage = document.getElementById('modalMessage');

    let isRunning = false;
    let isWorkMode = true;
    let timer;
    let timeLeft = workInput.value * 60;

    function updateTimerDisplay() {
      let minutes = Math.floor(timeLeft / 60);
      let seconds = timeLeft % 60;
      timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
    }

    function showModal(title, message) {
      modalTitle.textContent = title;
      modalMessage.textContent = message;
      modal.style.display = 'flex';
    }

    function closeModal() {
      modal.style.display = 'none';
    }

    function startTimer() {
      if (isRunning) return;
      isRunning = true;
      timer = setInterval(() => {
        timeLeft--;
        updateTimerDisplay();
        if (timeLeft <= 0) {
          clearInterval(timer);
          isWorkMode = !isWorkMode;
          modeText.textContent = isWorkMode ? "Focus Mode 🔥" : "Break Time ☕";

          // Themed modal alert
          if (isWorkMode) {
            showModal("Break Over 💪", "Let's get back to work!");
          } else {
            showModal("Focus Complete 🎉", "Time to take a short break ☕");
          }

          timeLeft = (isWorkMode ? workInput.value : breakInput.value) * 60;
          isRunning = false;
        }
      }, 1000);
    }

    function pauseTimer() {
      clearInterval(timer);
      isRunning = false;
    }

    function resetTimer() {
      clearInterval(timer);
      isRunning = false;
      isWorkMode = true;
      modeText.textContent = "Focus Mode 🔥";
      timeLeft = workInput.value * 60;
      updateTimerDisplay();
    }

    startBtn.addEventListener('click', startTimer);
    pauseBtn.addEventListener('click', pauseTimer);
    resetBtn.addEventListener('click', resetTimer);
    workInput.addEventListener('change', resetTimer);
    breakInput.addEventListener('change', resetTimer);

    updateTimerDisplay();
  </script>
</body>
</html>
