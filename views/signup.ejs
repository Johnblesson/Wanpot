<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WANPOT | Signup</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="icon" href="/images/wanpot.ico" type="image/x-icon">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <div class="auth-container">
    <!-- ✅ WANPOT LOGO -->
    <div class="logo">
      <img src="/images/wanpot.ico" alt="Wanpot Logo">
    </div>
    <p>Create your unified workspace</p>

    <% if (errorMessages && errorMessages.length > 0) { %>
      <% errorMessages.forEach(msg => { %>
        <div class="error-message"><%= msg %></div>
      <% }) %>
    <% } %>

    <form action="/api/auth/signup" method="POST">

      <div class="input-group">
        <input 
          type="text" 
          name="fullname" 
          placeholder="Full Name" 
          value="<%= old ? old.fullname : '' %>"
          class="<%= errorFields && errorFields.fullname ? 'input-error' : '' %>"
          required
        >
      </div>

      <div class="input-group">
        <input 
          type="text" 
          name="username" 
          placeholder="Username" 
          value="<%= old ? old.username : '' %>"
          class="<%= errorFields && errorFields.username ? 'input-error' : '' %>"
          required
        >
      </div>

      <div class="input-group">
        <input 
          type="tel" 
          name="phone" 
          placeholder="Phone"
          value="<%= old ? old.phone : '' %>"
          class="<%= errorFields && errorFields.phone ? 'input-error' : '' %>"
          required
        >
      </div>

      <div class="input-group">
        <input 
          type="email" 
          name="email" 
          placeholder="Email (Optional)"
          value="<%= old ? old.email : '' %>"
          class="<%= errorFields && errorFields.email ? 'input-error' : '' %>"
        >
      </div>

      <div class="input-group">
        <input 
          type="password" 
          name="password" 
          id="password"
          placeholder="Password"
          value="<%= old ? old.password : '' %>"
          class="<%= errorFields && errorFields.password ? 'input-error' : '' %>"
          required
        >
        <i class="fa-solid fa-eye toggle-password" id="togglePassword"></i>
      </div>

      <button type="submit">Create Account</button>
    </form>


    <a href="/login" class="link">Already have an account? Sign in</a>
  </div>

  <script>
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');

    togglePassword.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      togglePassword.classList.toggle('fa-eye');
      togglePassword.classList.toggle('fa-eye-slash');
    });
  </script>
</body>
</html>
