<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wanpot AI Chat</title>
  <link rel="icon" href="/images/wanpot.ico" type="image/x-icon">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/ai.css">
  <style>
    .delete-icon {
      cursor: pointer;
      margin-left: 10px;
      color: #f87171; /* soft red */
      font-size: 0.85rem;
    }
    .message-wrapper {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
    .clear-btn {
      display: block;
      margin: 10px auto;
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
      background: #ef4444;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s;
    }
    .clear-btn:hover {
      background: #dc2626;
    }
  </style>
</head>
<body>

  <!-- ✅ WANPOT HEADER -->
  <header>
    <img src="/images/wanpot.ico" alt="Wanpot Logo">
    <h1>WANPOT AI ASSISTANT</h1>
    <div style="width:40px;"></div>
  </header>

  <!-- ✅ ABOUT SECTION -->
  <section class="ai-about">
    <h2>About Wanpot AI</h2>
    <p>
      Wanpot AI is your intelligent assistant powered by next-generation machine learning.
      Ask questions, get instant explanations, brainstorm ideas, or clarify technical and academic concepts —
      all in your familiar Wanpot environment.
    </p>
  </section>

  <!-- ✅ CLEAR CHAT BUTTON -->
  <button class="clear-btn" onclick="clearAllChat()">🗑️ Clear All Chat</button>

  <!-- ✅ CHAT CONTAINER -->
  <div class="chat-container" id="chatContainer">
    <% if (messages && messages.length) { %>
      <% messages.forEach((msg, idx) => { %>
        <div class="message <%= msg.sender === 'user' ? 'user-msg' : 'ai-msg' %>">
          <div class="message-wrapper">
            <span><%= msg.text %></span>
            <i class="fas fa-trash delete-icon" onclick="deleteMessage(<%= idx %>)"></i>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="message ai-msg">👋 Hello! I’m Wanpot AI — how can I assist you today?</div>
    <% } %>
  </div>

  <!-- ✅ INPUT AREA -->
  <form id="chatForm" class="chat-input-wrapper">
    <div class="input-container">
      <input 
        type="text" 
        name="prompt" 
        id="prompt" 
        placeholder="Type your message..." 
        autocomplete="off" 
        required
      >
      <button type="submit" id="sendButton">
        <i class="fas fa-paper-plane"></i>
      </button>
    </div>
    <input type="hidden" name="chatHistory" id="chatHistory" value='<%= JSON.stringify(messages || []) %>'>
    <input type="hidden" name="chatId" id="chatId" value="<%= chatId || '' %>">
  </form>

  <footer>© 2025 Wanpot | Powered by Kharis Pro Tech</footer>

  <!-- ✅ SCRIPT -->
  <script>
    const chatContainer = document.getElementById('chatContainer');
    const chatForm = document.getElementById('chatForm');
    const promptInput = document.getElementById('prompt');
    const chatHistoryInput = document.getElementById('chatHistory');
    const chatIdInput = document.getElementById('chatId');
    const sendButton = document.getElementById('sendButton');

    function scrollToBottom() {
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }
    scrollToBottom();

    chatForm.addEventListener('submit', async e => {
      e.preventDefault();
      const prompt = promptInput.value.trim();
      if (!prompt) return;

      sendButton.classList.add('sending');
      setTimeout(() => sendButton.classList.remove('sending'), 400);

      let chatHistory = chatHistoryInput.value ? JSON.parse(chatHistoryInput.value) : [];
      chatHistory.push({ sender: 'user', text: prompt });
      addMessageToUI('user', prompt, chatHistory.length - 1);
      scrollToBottom();
      promptInput.value = '';

      try {
        const res = await fetch('/ai', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt, chatId: chatIdInput.value })
        });
        const data = await res.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(data, 'text/html');
        const aiMessages = doc.querySelectorAll('.ai-msg');
        aiMessages.forEach(msgDiv => {
          chatHistory.push({ sender: 'ai', text: msgDiv.innerText });
          addMessageToUI('ai', msgDiv.innerText, chatHistory.length - 1);
        });

        chatHistoryInput.value = JSON.stringify(chatHistory);
        const newChatId = doc.querySelector('#chatId')?.value;
        if (newChatId) chatIdInput.value = newChatId;
        scrollToBottom();
      } catch (err) {
        addMessageToUI('ai', '⚠️ Error generating response. Please try again later.', chatHistory.length);
        chatHistory.push({ sender: 'ai', text: 'Error generating response. Try again later.' });
        chatHistoryInput.value = JSON.stringify(chatHistory);
        scrollToBottom();
      }
    });

    function addMessageToUI(sender, text, idx) {
      const div = document.createElement('div');
      div.classList.add('message', sender === 'user' ? 'user-msg' : 'ai-msg');
      div.innerHTML = `<div class="message-wrapper"><span>${text}</span>
        <i class="fas fa-trash delete-icon" onclick="deleteMessage(${idx})"></i>
      </div>`;
      chatContainer.appendChild(div);
    }

    function deleteMessage(idx) {
      let chatHistory = chatHistoryInput.value ? JSON.parse(chatHistoryInput.value) : [];
      chatHistory.splice(idx, 1);
      chatHistoryInput.value = JSON.stringify(chatHistory);
      renderChatHistory(chatHistory);
    }

    function clearAllChat() {
      chatHistoryInput.value = '[]';
      renderChatHistory([]);
    }

    function renderChatHistory(chatHistory) {
      chatContainer.innerHTML = '';
      if (chatHistory.length === 0) {
        chatContainer.innerHTML = '<div class="message ai-msg">👋 Hello! I’m Wanpot AI — how can I assist you today?</div>';
        return;
      }
      chatHistory.forEach((msg, idx) => {
        addMessageToUI(msg.sender, msg.text, idx);
      });
      scrollToBottom();
    }
  </script>
</body>
</html>
