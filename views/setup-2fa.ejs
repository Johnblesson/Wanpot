<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wanpot | 2FA Verification</title>
  <style>
    /* General Reset */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: #f8fafc;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
    }

    /* Container */
    .container {
      background: rgba(30, 41, 59, 0.85);
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      padding: 40px 30px;
      width: 420px;
      text-align: center;
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .photo {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      display: block;
      margin: 0 auto 15px;
      border: 2px solid #38bdf8;
      background-color: #f8fafc;
      object-fit: cover;
    }

    h1 {
      font-size: 1.6em;
      margin-bottom: 15px;
      color: #f1f5f9;
    }

    p {
      font-size: 1em;
      color: #cbd5e1;
      margin-bottom: 20px;
    }

    strong p {
      color: #38bdf8;
      font-weight: 600;
    }

    label {
      font-size: 0.95em;
      line-height: 1.5;
      color: #94a3b8;
      margin-bottom: 15px;
      display: block;
    }

    input[type="text"] {
      padding: 12px;
      font-size: 16px;
      border: 1px solid #334155;
      border-radius: 8px;
      background: #1e293b;
      color: #f8fafc;
      width: 100%;
      margin: 15px 0 25px;
      transition: all 0.3s ease;
    }

    input[type="text"]:focus {
      border-color: #38bdf8;
      outline: none;
      box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.3);
    }

    .twofa-img {
      width: 100px;
      height: auto;
      margin: 0 auto 10px;
      display: block;
      opacity: 0.9;
    }

    button {
      width: 100%;
      padding: 12px;
      font-size: 16px;
      font-weight: 600;
      color: #fff;
      background: linear-gradient(90deg, #2563eb, #38bdf8);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    button:hover {
      background: linear-gradient(90deg, #1e40af, #0ea5e9);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(14, 165, 233, 0.4);
    }

    .resend {
      margin-top: 20px;
      font-size: 0.9em;
      color: #94a3b8;
    }

    .resend a {
      color: #38bdf8;
      text-decoration: none;
      font-weight: 500;
      opacity: 0.8;
      pointer-events: none;
      transition: all 0.3s ease;
    }

    .resend a.active {
      opacity: 1;
      pointer-events: all;
    }

    .resend a:hover {
      text-decoration: underline;
    }

    .timer {
      display: block;
      margin-top: 5px;
      color: #64748b;
      font-size: 0.85em;
    }

    .error-message {
      color: #f87171;
      margin-top: 15px;
      font-size: 0.9em;
    }

    @media (max-width: 500px) {
      .container {
        width: 90%;
        padding: 25px 20px;
      }
      h1 {
        font-size: 1.4em;
      }
      input[type="text"], button {
        font-size: 15px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <img class="photo" src="/images/wanpot.png" alt="User Photo">
    <strong><p><%= user ? user.fullname : '' %> - Wanpot</p></strong>
    <h1>Two-Factor Authentication</h1>
    <p>Open your authentication app and enter the 6-digit code.</p>

    <form action="/verify-2fa" method="POST">
      <img class="twofa-img" src="/images/2fa.png" alt="2FA Illustration">
      <label for="token">Enter your authentication code</label>
      <input type="text" id="token" name="token" placeholder="Enter 6-digit code" required>
      <button type="submit">Verify</button>
    </form>

    <div class="resend">
      Didn’t receive the code?
      <a id="resendLink" href="/" class="">Resend Code</a>
      <span id="timer" class="timer">(Wait 60s)</span>
    </div>
  </div>
 <script>
  let timeLeft = 60;
  const resendLink = document.getElementById("resendLink");
  const timer = document.getElementById("timer");

  resendLink.classList.remove("active");
  timer.textContent = `(Wait ${timeLeft}s)`; // update initial display

  const countdown = setInterval(() => {
    timeLeft--;
    timer.textContent = `(Wait ${timeLeft}s)`;

    if (timeLeft <= 0) {
      clearInterval(countdown);
      resendLink.classList.add("active");
      timer.textContent = "";
    }
  }, 1000);
</script>

</body>
</html>
