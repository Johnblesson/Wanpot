<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wanpot - Email Signature Generator</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: #f8fafc;
      overflow-x: hidden;
    }

    header {
      position: fixed;
      top: 0; width: 100%;
      z-index: 100;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .navbar {
      max-width: 1200px; margin: 0 auto;
      padding: 1rem 2rem;
      display: flex; justify-content: space-between; align-items: center;
    }

    .logo {
      font-size: 1.7rem; font-weight: 700;
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    nav ul {
      list-style: none;
      display: flex; gap: 1.5rem;
    }

    nav ul li a {
      text-decoration: none;
      color: #f1f5f9;
      font-weight: 500;
      transition: color 0.3s;
    }

    nav ul li a:hover { color: #38bdf8; }

    .menu-toggle { display: none; font-size: 1.8rem; cursor: pointer; color: #fff; }

    /* MAIN */
    .container {
      padding: 8rem 1rem 3rem;
      max-width: 1200px;
      margin: auto;
      text-align: center;
    }

    h1 {
      font-size: 2.4rem;
      margin-bottom: 1rem;
      color: #38bdf8;
    }

    p {
      color: #cbd5e1;
      max-width: 600px;
      margin: 0 auto 2rem;
    }

    .generator {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-top: 2rem;
      align-items: start;
    }

    form {
      background: rgba(255,255,255,0.06);
      padding: 2rem;
      border-radius: 15px;
      border: 1px solid rgba(255,255,255,0.1);
    }

    form label {
      display: block;
      text-align: left;
      margin-top: 1rem;
      font-weight: 500;
      color: #e2e8f0;
    }

    form input {
      width: 100%;
      margin-top: 0.3rem;
      padding: 0.6rem;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.05);
      color: #f8fafc;
    }

    form input:focus {
      outline: none;
      border-color: #38bdf8;
    }

    .preview {
      background: rgba(255,255,255,0.06);
      padding: 2rem;
      border-radius: 15px;
      border: 1px solid rgba(255,255,255,0.1);
      text-align: left;
      min-height: 250px;
    }

    .signature {
      border-top: 2px solid #38bdf8;
      margin-top: 1rem;
      padding-top: 1rem;
      color: #e2e8f0;
      font-size: 0.95rem;
    }

    .signature strong {
      color: #38bdf8;
      font-size: 1.1rem;
    }

    .copy-btn {
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      border: none;
      color: #fff;
      font-weight: 600;
      padding: 0.8rem 1.6rem;
      border-radius: 50px;
      cursor: pointer;
      transition: 0.3s;
      margin-top: 1rem;
      width: 100%;
    }

    .copy-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 5px 20px rgba(6,182,212,0.4);
    }

    .copy-message {
      margin-top: 0.8rem;
      color: #38bdf8;
      font-size: 0.9rem;
      display: none;
    }

    /* ABOUT */
    .about {
      text-align: center;
      background: linear-gradient(90deg, #1e3a8a, #2563eb);
      padding: 3rem 1rem;
      border-top: 1px solid rgba(255,255,255,0.1);
      color: #f8fafc;
    }

    footer {
      text-align: center;
      padding: 2rem 1rem;
      background: #0f172a;
      color: #64748b;
      font-size: 0.9rem;
    }

    @media(max-width:768px){
      nav ul {
        display: none;
        flex-direction: column;
        position: absolute;
        right: 20px;
        top: 70px;
        width: 200px;
        background: rgba(15,23,42,0.9);
        border-radius: 10px;
        padding: 1rem;
      }

      nav ul.active { display: flex; }
      .menu-toggle { display: block; }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="navbar">
      <div class="logo">Wanpot</div>
      <nav>
        <ul>
          <li><a href="index.html#home">Home</a></li>
          <li><a href="index.html#features">Features</a></li>
          <li><a href="index.html#about">About</a></li>
        </ul>
      </nav>
      <div class="menu-toggle" onclick="toggleMenu()">☰</div>
    </div>
  </header>

  <!-- Main Section -->
  <section class="container">
    <h1>Email Signature Generator ✉️</h1>
    <p>Create a professional, clean, and modern email signature for your messages — personalized and ready to copy!</p>

    <div class="generator">
      <form id="signatureForm">
        <label>Full Name</label>
        <input type="text" id="name" placeholder="John Doe" />

        <label>Job Title</label>
        <input type="text" id="title" placeholder="Software Engineer" />

        <label>Company</label>
        <input type="text" id="company" placeholder="Kharis Pro Tech" />

        <label>Phone</label>
        <input type="text" id="phone" placeholder="+232 77 000 000" />

        <label>Website</label>
        <input type="text" id="website" placeholder="www.kharisprotech.com" />

        <label>Email</label>
        <input type="text" id="email" placeholder="info@kharisprotech.com" />

        <label>LinkedIn</label>
        <input type="text" id="linkedin" placeholder="linkedin.com/in/yourname" />

        <button type="button" class="copy-btn" onclick="copySignature()">Copy Signature</button>
        <div class="copy-message" id="copyMessage">✅ Signature copied to clipboard!</div>
      </form>

      <div class="preview">
        <h3>Preview:</h3>
        <div class="signature" id="signaturePreview">
          <strong>John Doe</strong><br>
          Software Engineer | Kharis Pro Tech<br>
          📞 +232 77 000 000<br>
          🌐 www.kharisprotech.com<br>
          ✉️ info@kharisprotech.com<br>
          🔗 linkedin.com/in/yourname
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="about">
    <h2>Professionalism Made Simple</h2>
    <p>Your digital identity starts with your emails. Wanpot helps you craft elegant, consistent signatures that make every message stand out.</p>
  </section>

  <!-- Footer -->
  <footer>
    <p>© 2025 Wanpot | Built with ❤️ in Sierra Leone by <strong>Kharis Pro Tech</strong></p>
  </footer>

  <script>
    function toggleMenu() {
      document.querySelector('nav ul').classList.toggle('active');
    }

    const fields = ['name', 'title', 'company', 'phone', 'website', 'email', 'linkedin'];
    fields.forEach(id => {
      document.getElementById(id).addEventListener('input', updateSignature);
    });

    function updateSignature() {
      const name = document.getElementById('name').value || 'John Doe';
      const title = document.getElementById('title').value || 'Software Engineer';
      const company = document.getElementById('company').value || 'Kharis Pro Tech';
      const phone = document.getElementById('phone').value || '+232 77 000 000';
      const website = document.getElementById('website').value || 'www.kharisprotech.com';
      const email = document.getElementById('email').value || 'info@kharisprotech.com';
      const linkedin = document.getElementById('linkedin').value || 'linkedin.com/in/yourname';

      const html = `
        <strong>${name}</strong><br>
        ${title} | ${company}<br>
        📞 ${phone}<br>
        🌐 ${website}<br>
        ✉️ ${email}<br>
        🔗 ${linkedin}
      `;
      document.getElementById('signaturePreview').innerHTML = html;
    }

    function copySignature() {
      const signatureHTML = document.getElementById('signaturePreview').innerHTML;
      const tempElement = document.createElement('textarea');
      tempElement.value = signatureHTML;
      document.body.appendChild(tempElement);
      tempElement.select();
      document.execCommand('copy');
      document.body.removeChild(tempElement);

      const msg = document.getElementById('copyMessage');
      msg.style.display = 'block';
      setTimeout(() => msg.style.display = 'none', 2000);
    }
  </script>
</body>
</html>
