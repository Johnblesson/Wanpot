<style>
  /* Container & Header */
  #coverLetterContainer {
    margin: 115px auto 40px;
    width: 93%;
    max-width: 900px;
    background: rgba(15,23,42,0.85);
    padding: 2rem;
    border-radius: 20px;
    border: 1px solid rgba(59,130,246,0.4);
    box-shadow: 0 10px 40px rgba(6,182,212,0.2);
    backdrop-filter: blur(6px);
    transition: all 0.3s ease;
  }

  .ai-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 1rem;
    background: linear-gradient(90deg,#3b82f6,#06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .ai-title i { font-size: 2rem; color: #38bdf8; }

  .about-wanpot {
    background: rgba(59,130,246,0.05);
    border-left: 4px solid #3b82f6;
    padding: 1rem;
    border-radius: 12px;
    margin-bottom: 1rem;
    color: #cbd5e1;
    line-height: 1.6;
    font-size: 1rem;
  }

  /* Textarea */
  .prompt-input {
    width: 100%;
    min-height: 160px;
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid rgba(59,130,246,0.3);
    background: rgba(30,41,59,0.85);
    color: #e2e8f0;
    resize: vertical;
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 1rem;
    transition: 0.3s;
  }
  .prompt-input:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 12px rgba(59,130,246,0.7);
  }

  /* Run Button */
  .run-btn {
    width: 100%;
    padding: 1rem;
    border: none;
    border-radius: 14px;
    background: linear-gradient(90deg,#3b82f6,#06b6d4);
    color: #fff;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-bottom: 1rem;
  }
  .run-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(6,182,212,0.4);
  }

  /* Loader */
  .loader {
    display: none;
    text-align: center;
    color: #38bdf8;
    margin-bottom: 1rem;
    font-weight: 500;
    font-size: 1rem;
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  /* Response Box */
  .response-box {
    display: none;
    background: rgba(0,0,0,0.3);
    border-radius: 14px;
    border: 1px solid rgba(59,130,246,0.3);
    padding: 1rem;
    margin-top: 1rem;
    transition: all 0.4s ease;
  }
  .response-box h3 {
    margin-bottom: 0.8rem;
    color: #38bdf8;
  }
  .response-box pre {
    white-space: pre-wrap;
    word-wrap: break-word;
    font-family: "Courier New", monospace;
    font-size: 0.95rem;
    color: #e2e8f0;
    background: rgba(30,41,59,0.9);
    padding: 1rem;
    border-radius: 10px;
    margin: 0 0 1rem 0;
  }

  /* Controls */
  .controls {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }
  .copy-btn, .download-btn {
    padding: 8px 15px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    font-weight: 600;
    transition: 0.3s;
  }
  .copy-btn {
    background: #38bdf8;
    color: #000;
  }
  .copy-btn:hover {
    background: #0ea5e9;
    color: #fff;
  }
  .download-btn {
    background: #06b6d4;
    color: #fff;
  }
  .download-btn:hover {
    background: #0b7285;
  }

  @media (max-width: 768px) {
    .controls {
      flex-direction: column;
      align-items: stretch;
    }
    .copy-btn, .download-btn {
      width: 100%;
    }
  }
</style>

<div class="container" id="coverLetterContainer">
  <div class="ai-title">
    <i class="fas fa-pen-nib"></i> AI Cover Letter Generator
  </div>

  <p class="about-wanpot">
    Input the job description or role you are applying for, and Wanpot AI will generate a professional, tailored cover letter ready to use.
  </p>

  <% if (error) { %>
    <div style="color:red; margin-bottom:12px;"><%= error %></div>
  <% } %>

  <textarea id="jobDescriptionInput" class="prompt-input" placeholder="Paste job description here..."><%= jobDescription || "" %></textarea>

  <button class="run-btn" id="generateCoverLetterBtn">Generate Cover Letter</button>

  <div class="loader" id="coverLetterLoader">⏳ AI is crafting your cover letter...</div>

  <div id="coverLetterResponse" class="response-box">
    <h3>Cover Letter:</h3>
    <pre id="coverLetterOutput"><%= coverLetter || "" %></pre>
    <div class="controls">
      <button class="copy-btn" id="copyCoverLetterBtn">Copy</button>
      <button class="download-btn" id="downloadCoverLetterBtn">Download .txt</button>
    </div>
  </div>
</div>

<script>
  const jobInput = document.getElementById("jobDescriptionInput");
  const generateBtn = document.getElementById("generateCoverLetterBtn");
  const loader = document.getElementById("coverLetterLoader");
  const responseBox = document.getElementById("coverLetterResponse");
  const outputBox = document.getElementById("coverLetterOutput");

  responseBox.style.display = "<%= coverLetter ? 'block' : 'none' %>";

  generateBtn.addEventListener("click", async () => {
    const jobDescription = jobInput.value.trim();
    if (!jobDescription) return alert("Please provide a job description.");

    loader.style.display = "block";
    responseBox.style.display = "none";

    try {
      const res = await fetch("/ai/cover-letter/run", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ jobDescription })
      });

      const data = await res.json();
      loader.style.display = "none";
      responseBox.style.display = "block";
      outputBox.innerText = data.error ? "❌ " + data.error : data.coverLetter;

    } catch (err) {
      console.error(err);
      loader.style.display = "none";
      responseBox.style.display = "block";
      outputBox.innerText = "❌ Network or server error.";
    }
  });

  document.getElementById("copyCoverLetterBtn").addEventListener("click", () => {
    if (outputBox.innerText.trim()) {
      navigator.clipboard.writeText(outputBox.innerText);
      alert("Copied to clipboard!");
    }
  });

  document.getElementById("downloadCoverLetterBtn").addEventListener("click", () => {
    if (!outputBox.innerText.trim()) return;
    const blob = new Blob([outputBox.innerText], { type: "text/plain" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "cover-letter.txt";
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
