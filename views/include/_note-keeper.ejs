<link rel="stylesheet" href="/css/note.css">
  <div class="container">
    <h2>Welcome, <%= user.fullname %></h2>

    <form action="/notes/add" method="POST">
      <input type="text" name="title" placeholder="Note Title" required>
      <textarea name="content" rows="3" placeholder="Write your note..." required></textarea>
      <button type="submit">Add Note</button>
    </form>
    <div class="notes-list">
      <% if (notes.length > 0) { %>
        <% notes.forEach(note => { %>
          <div class="note" data-id="<%= note._id %>">
            
            <h3><%= note.title %></h3>

            <div class="content">
              <%= note.content.length > 120 ? note.content.substring(0, 120) + "..." : note.content %>
            </div>

            <div class="actions">
              <a href="/notes/edit/<%= note._id %>" class="edit-btn" title="Edit Note">
                <i class="fas fa-edit"></i>
              </a>
              <a href="/notes/view/<%= note._id %>" class="view-btn" title="View Note">
                <i class="fas fa-eye"></i>
              </a>
              <a href="/notes/delete/<%= note._id %>" class="delete-btn" title="Delete Note" onclick="return confirm('Delete this note?')">
                <i class="fas fa-trash"></i>
              </a>
            </div>

          </div>
        <% }) %>
      <% } else { %>
        <p style="text-align:center; color:#94a3b8;">No notes yet. Add one above!</p>
      <% } %>
    </div>

</div>

<script src="/js/note.js"></script>
