<style>
  main {
    margin: 20px auto 40px;
    margin-top: 115px;
    width: 93%;
    max-width: 900px;
    background: rgba(15,23,42,0.85);
    padding: 2rem;
    border-radius: 20px;
    border: 1px solid rgba(59,130,246,0.4);
    box-shadow: 0 10px 40px rgba(6,182,212,0.2);
    backdrop-filter: blur(6px);
    transition: all 0.3s ease;
  }
  .ai-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 1rem;
    background: linear-gradient(90deg,#3b82f6,#06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .ai-title i { font-size: 2rem; color: #38bdf8; }
  #textInput{
    width: 100%;
    min-height: 160px;
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid rgba(59,130,246,0.3);
    background: rgba(30,41,59,0.85);
    color: #e2e8f0;
    resize: vertical;
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 1rem;
    transition: 0.3s;
  }
  #generateBtn { margin-top:0.8rem; padding:0.7rem 1.2rem; background:#3b82f6; border:none; color:#fff; border-radius:8px; cursor:pointer; transition:0.2s; }
  #generateBtn:hover { background:#06b6d4;}
  #loader { display:none; margin-top:1rem; text-align:center; }
  #resultWrap { display:none; margin-top:1rem; background: rgba(255,255,255,0.05); padding:1rem; border-radius:12px; }
  #result { white-space: pre-wrap; line-height:1.5; }
  .btn-group { margin-top:0.5rem; display:flex; gap:0.5rem; flex-wrap: wrap; }
  .btn { padding:0.4rem 0.8rem; border:none; border-radius:6px; cursor:pointer; transition:0.2s; }
  .copy-btn { background: rgba(59,130,246,0.1); color:#3b82f6; }
  .copy-btn:hover { background:#3b82f6; color:#fff; }
  .download-btn { background: rgba(6,182,212,0.1); color:#06b6d4; }
  .download-btn:hover { background:#06b6d4; color:#fff; }
  .clear-btn { background: rgba(220,38,38,0.1); color:#dc2626; }
  .clear-btn:hover { background:#dc2626; color:#fff; }
  #historyContainer { margin-top:1.5rem; }
  #historyContainer div { margin-bottom:10px; padding:8px; background: rgba(56,189,248,0.05); border-radius:8px; }

.about-wanpot  {
    background: rgba(59,130,246,0.05);
    border-left: 4px solid #3b82f6;
    padding: 1rem;
    border-radius: 12px;
    margin-bottom: 1rem;
    color: #cbd5e1;
    line-height: 1.6;
    font-size: 1rem;
  }

</style>

<main>
  <div class="ai-title"><i class="fas fa-pen-nib"></i> AI Story Writer</div>
  <p class="about-wanpot">
    Enter a story idea, topic, or prompt below and get an instant story generated by AI.
  </p>

  <textarea id="textInput" rows="8" placeholder="Type your story prompt here..."></textarea>
  <button id="generateBtn">Generate Story</button>

  <div id="loader">⏳ Generating story...</div>

  <div id="resultWrap">
    <div id="result"></div>
    <div class="btn-group">
      <button class="btn copy-btn" id="copyBtn"><i class="fas fa-copy"></i> Copy</button>
      <button class="btn download-btn" id="downloadBtn"><i class="fas fa-download"></i> Download</button>
      <button class="btn clear-btn" id="clearBtn">Clear History</button>
    </div>
  </div>

  <h3 style="margin-top:2rem;">History</h3>
  <div id="historyContainer"></div>
</main>

<script>
  const textInput = document.getElementById("textInput");
  const generateBtn = document.getElementById("generateBtn");
  const loader = document.getElementById("loader");
  const resultWrap = document.getElementById("resultWrap");
  const resultEl = document.getElementById("result");
  const copyBtn = document.getElementById("copyBtn");
  const downloadBtn = document.getElementById("downloadBtn");
  const clearBtn = document.getElementById("clearBtn");
  const historyContainer = document.getElementById("historyContainer");

  function renderHistory() {
    const history = JSON.parse(localStorage.getItem('storyHistory') || '[]');
    historyContainer.innerHTML = '';
    if(history.length===0){ historyContainer.innerHTML='<p style="color:#94a3b8;">No history yet. Start writing stories!</p>'; return; }
    history.forEach(entry=>{
      const div=document.createElement('div');
      div.innerHTML=`<strong>Prompt:</strong> ${entry.prompt}<br><strong>Story:</strong> ${entry.story}<br><small style="color:#94a3b8;">${new Date(entry.timestamp).toLocaleString()}</small>`;
      historyContainer.appendChild(div);
    });
  }

  function saveToLocalHistory(prompt, story){
    const history = JSON.parse(localStorage.getItem('storyHistory') || '[]');
    history.unshift({ prompt, story, timestamp: new Date().toISOString() });
    localStorage.setItem('storyHistory', JSON.stringify(history));
    renderHistory();
  }

  renderHistory();

  generateBtn.addEventListener("click", async () => {
    const prompt = textInput.value.trim();
    if(!prompt){ alert("Please enter a prompt."); return; }

    loader.style.display="block";
    resultWrap.style.display="none";
    resultEl.textContent="";

    try {
      const res = await fetch("/ai/story-writer/run", {
        method:"POST",
        headers:{ "Content-Type":"application/json" },
        body: JSON.stringify({ prompt })
      });
      const data = await res.json();
      loader.style.display="none";
      if(data.error){ alert("Error: "+data.error); return; }

      resultEl.textContent = data.story || "No story generated.";
      resultWrap.style.display="block";
      saveToLocalHistory(prompt, data.story);
      resultWrap.scrollIntoView({ behavior:"smooth", block:"center" });
    } catch(err){
      loader.style.display="none";
      console.error(err);
      alert("❌ Network or server error.");
    }
  });

  copyBtn.addEventListener("click", () => {
    navigator.clipboard.writeText(resultEl.innerText).then(()=>{ copyBtn.innerText="Copied!"; setTimeout(()=>copyBtn.innerText="Copy",1400); });
  });

  downloadBtn.addEventListener("click", () => {
    const blob = new Blob([resultEl.innerText], { type:"text/plain" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href=url;
    a.download=`AIStory_${Date.now()}.txt`;
    a.click();
    URL.revokeObjectURL(url);
  });

  clearBtn.addEventListener("click", () => {
    if(!confirm("Clear all story history?")) return;
    localStorage.removeItem('storyHistory');
    renderHistory();
  });
</script> 
