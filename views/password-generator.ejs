<!-- views/password-generator.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Wanpot | Password Generator</title>

  <!-- Font + icons (optional) -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root{
      --bg1: #0f172a;
      --bg2: #1e293b;
      --accent1: #06b6d4;
      --accent2: #3b82f6;
      --card: rgba(255,255,255,0.04);
      --muted: #94a3b8;
      --good: #16a34a;
      --ok: #f59e0b;
      --bad: #ef4444;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: "Poppins", sans-serif;
      background: linear-gradient(135deg,var(--bg1),var(--bg2));
      color: #f8fafc;
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      display:flex;
      flex-direction:column;
      min-height:100vh;
    }

    /* include header (partial) will supply nav */
    main.app-container {
      max-width:1100px;
      width:95%;
      margin: 5.5rem auto 3rem;
      padding:1.5rem;
    }

    .card {
      background: var(--card);
      border: 1px solid rgba(255,255,255,0.06);
      padding:1.25rem;
      border-radius:14px;
      box-shadow: 0 8px 30px rgba(2,6,23,0.6);
      backdrop-filter: blur(6px);
    }

    .grid {
      display:grid;
      grid-template-columns: 1fr 360px;
      gap:1.25rem;
    }

    h1{
      margin:0 0 0.5rem 0;
      font-size:1.6rem;
      color:linear-gradient(90deg,var(--accent2),var(--accent1));
    }

    .lead { color: var(--muted); margin-bottom:1rem; }

    /* Left column - controls */
    .controls { display:flex; flex-direction:column; gap:1rem; }

    .row { display:flex; gap:0.8rem; align-items:center; flex-wrap:wrap; }
    label.small { font-size:0.9rem; color:var(--muted); min-width:120px; }

    .control-group { background: rgba(255,255,255,0.02); padding:0.9rem; border-radius:10px; border:1px solid rgba(255,255,255,0.02); }

    input[type="range"]{
      width:100%;
      accent-color: var(--accent2);
    }

    .toggles { display:flex; flex-direction:column; gap:0.6rem; }
    .toggle {
      display:flex; align-items:center; gap:0.8rem; justify-content:space-between;
      background: rgba(255,255,255,0.02); padding:0.6rem 0.8rem; border-radius:8px;
    }
    .toggle input[type="checkbox"]{ width:18px; height:18px; accent-color:var(--accent1); }

    /* password preview area */
    .preview {
      display:flex; flex-direction:column; gap:0.6rem; align-items:stretch;
    }
    .password-box {
      background: rgba(0,0,0,0.35);
      padding:0.9rem 1rem;
      border-radius:10px;
      display:flex;
      gap:0.6rem;
      align-items:center;
      justify-content:space-between;
      font-weight:600;
      letter-spacing:0.6px;
      font-size:1rem;
      word-break:break-all;
    }
    .pw-actions { display:flex; gap:0.5rem; }

    .btn {
      background: linear-gradient(90deg,var(--accent2),var(--accent1));
      border:none;
      padding:0.6rem 0.9rem;
      border-radius:8px;
      color:#fff;
      font-weight:700;
      cursor:pointer;
      display:inline-flex;
      gap:0.6rem;
      align-items:center;
    }
    .btn.ghost { background: transparent; border: 1px solid rgba(255,255,255,0.06); color:#fff; }

    /* strength meter */
    .strength-wrap { display:flex; align-items:center; gap:1rem; margin-top:0.25rem; }
    .meter {
      width:160px; height:10px; background:rgba(255,255,255,0.06); border-radius:8px; overflow:hidden;
    }
    .meter-fill { height:100%; width:0%; background:var(--bad); transition:width 280ms ease; }

    .strength-label { font-size:0.95rem; color:var(--muted); }

    /* right column - vault & tips */
    .aside { display:flex; flex-direction:column; gap:1rem; }
    .tips { font-size:0.95rem; color:var(--muted); line-height:1.5; }
    .vault-list { max-height:260px; overflow:auto; padding:0.5rem; display:flex; flex-direction:column; gap:0.5rem; }
    .vault-item { background: rgba(255,255,255,0.02); padding:0.6rem; border-radius:8px; display:flex; justify-content:space-between; gap:0.5rem; align-items:center; font-size:0.95rem; }

    .small { font-size:0.9rem; color:var(--muted); }

    /* responsive */
    @media (max-width: 980px) {
      .grid { grid-template-columns: 1fr; }
      main.app-container { margin: 4.5rem auto 2rem; padding:1rem; width:95%; }
    }

    @media (max-width: 420px) {
      .password-box { font-size:0.92rem; }
      .btn { padding:0.5rem 0.6rem; font-size:0.86rem; }
      .meter { width:120px; }
    }
  </style>
</head>
<body>

  <!-- header partial (keeps nav consistent) -->
  <%- include('include/_header') %>

  <main class="app-container">
    <div class="card">
      <div style="display:flex; justify-content:space-between; gap:1rem; align-items:start; margin-bottom:1rem;">
        <div>
          <h1>Secure Password Generator</h1>
          <div class="lead">Create strong passwords — customizable length, character types, and save favorites locally.</div>
        </div>

        <div style="display:flex; gap:0.6rem; align-items:center;">
          <button class="btn" id="generateBtn"><i class="fa-solid fa-shield-halved"></i> Generate</button>
          <button class="btn ghost" id="copyBtn" title="Copy password"><i class="fa-regular fa-clipboard"></i> Copy</button>
        </div>
      </div>

      <div class="grid">

        <!-- left: controls -->
        <section class="controls">

          <div class="control-group">
            <div class="preview">
              <div class="password-box" id="passwordBox">••••••••••••••••••</div>
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div class="strength-wrap">
                  <div class="meter"><div class="meter-fill" id="meterFill"></div></div>
                  <div class="strength-label" id="strengthLabel">Strength: —</div>
                </div>

                <div class="small">Length: <strong id="lenLabel">16</strong></div>
              </div>
            </div>
          </div>

          <div class="control-group">
            <div class="row" style="align-items:center;">
              <label class="small">Password Length</label>
              <input type="range" id="lengthRange" min="6" max="128" value="16" />
            </div>
          </div>

          <div class="control-group toggles">
            <div class="toggle"><span>Include lowercase</span><input type="checkbox" id="lowercase" checked></div>
            <div class="toggle"><span>Include uppercase</span><input type="checkbox" id="uppercase" checked></div>
            <div class="toggle"><span>Include numbers</span><input type="checkbox" id="numbers" checked></div>
            <div class="toggle"><span>Include symbols</span><input type="checkbox" id="symbols" checked></div>
            <div class="toggle"><span>Exclude ambiguous (0O,l1,iI)</span><input type="checkbox" id="excludeAmb" checked></div>
          </div>

          <div class="control-group" style="display:flex; gap:0.6rem; flex-wrap:wrap;">
            <button class="btn" id="downloadBtn"><i class="fa-solid fa-file-arrow-down"></i> Download</button>
            <button class="btn ghost" id="saveBtn"><i class="fa-solid fa-bookmark"></i> Save to Vault</button>
            <button class="btn ghost" id="clearVaultBtn" title="Clear saved passwords"><i class="fa-solid fa-trash"></i> Clear Vault</button>
          </div>

        </section>

        <!-- right: tips & vault -->
        <aside class="aside">
          <div class="card tips">
            <h3 style="margin:0 0 0.5rem 0;">Why strong passwords?</h3>
            <ul style="margin:0 0 0 1.1rem; padding:0; color:var(--muted)">
              <li>Longer & random = harder to guess</li>
              <li>Use symbols + numbers for entropy</li>
              <li>Never reuse the same password across important accounts</li>
              <li>Use a password manager for many strong passwords</li>
            </ul>
          </div>

          <div class="card">
            <h3 style="margin:0 0 0.6rem 0;">🔐 Vault (Saved)</h3>
            <div class="vault-list" id="vaultList">
              <div class="small">No saved passwords yet.</div>
            </div>
          </div>

        </aside>
      </div>
    </div>
  </main>

  <!-- footer partial -->
  <%- include('include/_footer') %>

  <script>
    // Password generator logic
    const passwordBox = document.getElementById('passwordBox');
    const lengthRange = document.getElementById('lengthRange');
    const lenLabel = document.getElementById('lenLabel');
    const lowercase = document.getElementById('lowercase');
    const uppercase = document.getElementById('uppercase');
    const numbers = document.getElementById('numbers');
    const symbols = document.getElementById('symbols');
    const excludeAmb = document.getElementById('excludeAmb');

    const meterFill = document.getElementById('meterFill');
    const strengthLabel = document.getElementById('strengthLabel');

    const generateBtn = document.getElementById('generateBtn');
    const copyBtn = document.getElementById('copyBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const saveBtn = document.getElementById('saveBtn');
    const clearVaultBtn = document.getElementById('clearVaultBtn');
    const vaultList = document.getElementById('vaultList');

    // character sets
    const sets = {
      lower: 'abcdefghijklmnopqrstuvwxyz',
      upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
      num: '0123456789',
      sym: '!@#$%^&*()-_=+[]{};:,.<>?/|'
    };

    const ambiguous = '0O1lI|`\'"'; // characters to consider ambiguous

    // helpers
    function getCharPool() {
      let pool = '';
      if (lowercase.checked) pool += sets.lower;
      if (uppercase.checked) pool += sets.upper;
      if (numbers.checked) pool += sets.num;
      if (symbols.checked) pool += sets.sym;
      if (excludeAmb.checked) {
        pool = pool.split('').filter(c => !ambiguous.includes(c)).join('');
      }
      return pool;
    }

    function generatePassword(length) {
      const pool = getCharPool();
      if (!pool.length) return '';
      // ensure at least one of each selected type is included if length permits
      let pwd = [];
      let required = [];
      if (lowercase.checked) required.push(randomChar(sets.lower, excludeAmb.checked));
      if (uppercase.checked) required.push(randomChar(sets.upper, excludeAmb.checked));
      if (numbers.checked) required.push(randomChar(sets.num, excludeAmb.checked));
      if (symbols.checked) required.push(randomChar(sets.sym, excludeAmb.checked));

      // if required chars exceed length, trim required
      if (required.length > length) required = required.slice(0, length);

      // fill remaining
      for (let i=0;i<length - required.length;i++){
        pwd.push(randomChar(pool, false)); // pool already applied excludeAmb
      }
      // insert required at random positions
      for (const r of required) {
        const pos = Math.floor(Math.random() * (pwd.length + 1));
        pwd.splice(pos, 0, r);
      }
      // shuffle
      pwd = shuffleArray(pwd);
      return pwd.join('');
    }

    function randomChar(str, excludeAmbiguous) {
      if (excludeAmbiguous) {
        str = str.split('').filter(c => !ambiguous.includes(c)).join('');
      }
      return str[Math.floor(Math.random() * str.length)];
    }

    function shuffleArray(a) {
      for (let i=a.length-1;i>0;i--){
        const j = Math.floor(Math.random() * (i+1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    // strength estimation (very lightweight entropy approximation)
    function estimateStrength(password) {
      if (!password) return { score:0, label:'Empty' };
      // entropy per char estimate by pool size
      let poolSize = 0;
      if (/[a-z]/.test(password)) poolSize += 26;
      if (/[A-Z]/.test(password)) poolSize += 26;
      if (/[0-9]/.test(password)) poolSize += 10;
      if (/[^A-Za-z0-9]/.test(password)) poolSize += 30;
      const entropy = Math.log2(Math.pow(poolSize, password.length) || 1);
      // map entropy to score/label
      let score = 0;
      let label = 'Very Weak';
      if (entropy < 28) { score = 20; label = 'Very Weak'; }
      else if (entropy < 36) { score = 40; label = 'Weak'; }
      else if (entropy < 60) { score = 60; label = 'Fair'; }
      else if (entropy < 80) { score = 80; label = 'Strong'; }
      else { score = 100; label = 'Very Strong'; }
      return { score, label };
    }

    // UI actions
    function updateLengthLabel(){
      lenLabel.textContent = lengthRange.value;
    }

    function updatePasswordDisplay(pw){
      passwordBox.textContent = pw || '••••••••••••••••••';
      const {score,label} = estimateStrength(pw);
      meterFill.style.width = score + '%';
      if (score >= 80) meterFill.style.background = 'var(--good)';
      else if (score >= 60) meterFill.style.background = 'var(--ok)';
      else meterFill.style.background = 'var(--bad)';
      strengthLabel.textContent = `Strength: ${label}`;
    }

    lengthRange.addEventListener('input', () => {
      updateLengthLabel();
    });

    generateBtn.addEventListener('click', () => {
      const len = parseInt(lengthRange.value,10);
      const pw = generatePassword(len);
      updatePasswordDisplay(pw);
    });

    copyBtn.addEventListener('click', async () => {
      const txt = passwordBox.textContent;
      if (!txt || txt.includes('•')) return alert('No password to copy. Generate one first.');
      try {
        await navigator.clipboard.writeText(txt);
        alert('Password copied to clipboard ✅');
      } catch (e) {
        alert('Copy failed. Please select and copy manually.');
      }
    });

    downloadBtn.addEventListener('click', () => {
      const txt = passwordBox.textContent;
      if (!txt || txt.includes('•')) return alert('No password to download. Generate one first.');
      const blob = new Blob([txt], { type: 'text/plain' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'password.txt';
      a.click();
      URL.revokeObjectURL(a.href);
    });

    // vault (localStorage)
    function loadVault(){
      const items = JSON.parse(localStorage.getItem('wanpot_password_vault') || '[]');
      renderVault(items);
    }

    function renderVault(items){
      if (!items || !items.length) {
        vaultList.innerHTML = '<div class="small">No saved passwords yet.</div>';
        return;
      }
      vaultList.innerHTML = items.map((it,idx) => `
        <div class="vault-item">
          <div style="flex:1; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">
            <strong>${it.label || 'Saved'}</strong> — <span style="opacity:0.85; margin-left:6px">${it.pw}</span>
          </div>
          <div style="display:flex; gap:8px;">
            <button class="btn ghost" data-action="copy" data-idx="${idx}" title="Copy"><i class="fa-regular fa-clipboard"></i></button>
            <button class="btn ghost" data-action="del" data-idx="${idx}" title="Delete"><i class="fa-solid fa-trash"></i></button>
          </div>
        </div>
      `).join('');
    }

    saveBtn.addEventListener('click', () => {
      const txt = passwordBox.textContent;
      if (!txt || txt.includes('•')) return alert('No password to save. Generate one first.');
      const label = prompt('Label for this password (e.g., "Email", "Bank", leave blank):') || 'Saved';
      const records = JSON.parse(localStorage.getItem('wanpot_password_vault') || '[]');
      records.unshift({ label, pw: txt, created: Date.now() });
      // keep 20 latest
      localStorage.setItem('wanpot_password_vault', JSON.stringify(records.slice(0,20)));
      loadVault();
      alert('Password saved to your vault (local storage).');
    });

    clearVaultBtn.addEventListener('click', () => {
      if (!confirm('Clear all saved passwords from local vault? This cannot be undone.')) return;
      localStorage.removeItem('wanpot_password_vault');
      loadVault();
    });

    // delegate vault actions
    vaultList.addEventListener('click', (e) => {
      const btn = e.target.closest('button');
      if(!btn) return;
      const action = btn.getAttribute('data-action');
      const idx = parseInt(btn.getAttribute('data-idx'),10);
      const records = JSON.parse(localStorage.getItem('wanpot_password_vault') || '[]');
      if (action === 'copy') {
        const entry = records[idx];
        if (entry) {
          navigator.clipboard.writeText(entry.pw).then(()=> alert('Copied to clipboard ✅'));
        }
      } else if (action === 'del') {
        if (!confirm('Delete this saved password?')) return;
        records.splice(idx,1);
        localStorage.setItem('wanpot_password_vault', JSON.stringify(records));
        loadVault();
      }
    });

    // initialize defaults
    updateLengthLabel();
    updatePasswordDisplay('');
    loadVault();

    // generate a password on first load for convenience
    window.addEventListener('load', () => {
      generateBtn.click();
    });

  </script>
</body>
</html>
