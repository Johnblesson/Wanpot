<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wanpot | Advanced Stopwatch with Laps</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="icon" href="/images/wanpot.ico" type="image/x-icon">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: #f8fafc;
      margin: 0;
      overflow-x: hidden;
    }

    /* Stopwatch Section */
    .stopwatch-container {
      margin-top: 8rem;
      text-align: center;
      padding: 2rem;
    }

    h1 {
      font-size: 2.2rem;
      color: #38bdf8;
      margin-bottom: 1.5rem;
    }

    .display {
      font-size: 3rem;
      background: rgba(0, 0, 0, 0.3);
      padding: 20px 40px;
      border-radius: 12px;
      display: inline-block;
      margin-bottom: 2rem;
      box-shadow: 0 0 10px rgba(56,189,248,0.3);
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }

    button {
      padding: 0.8rem 1.6rem;
      font-size: 1rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: 0.3s;
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      color: #fff;
      font-weight: 600;
      box-shadow: 0 4px 12px rgba(6,182,212,0.3);
    }

    button:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 20px rgba(6,182,212,0.5);
    }

    /* Lap List */
    .laps {
      max-width: 400px;
      margin: 0 auto;
      background: rgba(15,23,42,0.6);
      border-radius: 10px;
      padding: 1rem;
      box-shadow: 0 0 15px rgba(6,182,212,0.2);
      overflow-y: auto;
      max-height: 250px;
    }

    .lap {
      display: flex;
      justify-content: space-between;
      background: rgba(30,41,59,0.7);
      padding: 0.7rem 1rem;
      border-radius: 6px;
      margin-bottom: 0.5rem;
      font-weight: 500;
      color: #e2e8f0;
    }

    .lap span:first-child {
      color: #38bdf8;
    }

    /* Share Buttons */
    .share-buttons {
      margin-top: 1.5rem;
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .share-buttons button {
      background: linear-gradient(90deg, #22c55e, #16a34a);
    }

    .share-buttons button:nth-child(2) {
      background: linear-gradient(90deg, #f59e0b, #f97316);
    }

    /* Stopwatch Features Section */
    .features {
      text-align: center;
      margin-top: 4rem;
      padding: 3rem 1rem;
      background: rgba(15,23,42,0.7);
      border-top: 1px solid rgba(56,189,248,0.2);
    }

    .features h2 {
      font-size: 2rem;
      color: #38bdf8;
      margin-bottom: 2rem;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .feature-card {
      background: rgba(30,41,59,0.7);
      border-radius: 12px;
      padding: 1.5rem;
      transition: 0.3s;
      box-shadow: 0 0 15px rgba(56,189,248,0.1);
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 25px rgba(56,189,248,0.3);
    }

    .feature-icon {
      font-size: 2rem;
      color: #06b6d4;
      margin-bottom: 1rem;
    }

    .feature-card h3 {
      font-size: 1.2rem;
      margin-bottom: 0.5rem;
      color: #f8fafc;
    }

    .feature-card p {
      color: #94a3b8;
      font-size: 0.95rem;
      line-height: 1.4;
    }

    footer {
      background: #0f172a;
      color: #64748b;
      text-align: center;
      padding: 2rem 1rem;
      margin-top: 4rem;
      font-size: 0.9rem;
    }

    footer strong {
      color: #38bdf8;
    }

  </style>
</head>

<body>

  <%- include('include/_header') %>

  <section class="stopwatch-container">
    <h1><i class="fa-solid fa-stopwatch"></i> Advanced Stopwatch</h1>
    <div class="display" id="display">00:00:00</div>

    <div class="buttons">
      <button id="startStopBtn"><i class="fa-solid fa-play"></i> Start</button>
      <button id="lapBtn" disabled><i class="fa-solid fa-flag"></i> Lap</button>
      <button id="resetBtn"><i class="fa-solid fa-rotate-left"></i> Reset</button>
    </div>

    <div class="laps" id="laps"></div>

    <div class="share-buttons">
      <button id="downloadBtn"><i class="fa-solid fa-file-arrow-down"></i> Download Laps</button>
      <button id="copyBtn"><i class="fa-solid fa-copy"></i> Copy to Clipboard</button>
    </div>
  </section>

  <!-- Stopwatch Features Section -->
  <section class="features">
    <h2><i class="fa-solid fa-bolt"></i> Stopwatch Features</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon"><i class="fa-solid fa-clock"></i></div>
        <h3>Accurate Timing</h3>
        <p>Experience precision down to the millisecond with JavaScript-powered tracking.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fa-solid fa-flag-checkered"></i></div>
        <h3>Lap Recording</h3>
        <p>Save every lap seamlessly as you go — perfect for workouts or experiments.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fa-solid fa-pause-circle"></i></div>
        <h3>Pause & Resume</h3>
        <p>Stop and restart without losing your recorded time or laps.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fa-solid fa-mobile-screen"></i></div>
        <h3>Responsive Design</h3>
        <p>Optimized for all screens — from laptops to mobile devices.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fa-solid fa-share-nodes"></i></div>
        <h3>Share & Export</h3>
        <p>Instantly download or copy your lap list to share your progress.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fa-solid fa-gauge-high"></i></div>
        <h3>Performance Optimized</h3>
        <p>Lightweight and efficient, ensuring smooth functionality without lag.</p>
      </div>
    </div>
  </section>

  <%- include('include/_about') %>
  <%- include('include/_footer') %>

  <script>
    let startTime, updatedTime, difference, tInterval;
    let running = false;
    let lapCounter = 1;
    let laps = [];

    const display = document.getElementById('display');
    const startStopBtn = document.getElementById('startStopBtn');
    const lapBtn = document.getElementById('lapBtn');
    const resetBtn = document.getElementById('resetBtn');
    const lapsContainer = document.getElementById('laps');
    const downloadBtn = document.getElementById('downloadBtn');
    const copyBtn = document.getElementById('copyBtn');

    function startStop() {
      if (!running) {
        startTime = new Date().getTime() - (difference || 0);
        tInterval = setInterval(updateTime, 1000);
        startStopBtn.innerHTML = '<i class="fa-solid fa-pause"></i> Stop';
        running = true;
        lapBtn.disabled = false;
      } else {
        clearInterval(tInterval);
        running = false;
        startStopBtn.innerHTML = '<i class="fa-solid fa-play"></i> Start';
        lapBtn.disabled = true;
      }
    }

    function reset() {
      clearInterval(tInterval);
      running = false;
      difference = 0;
      display.innerHTML = '00:00:00';
      startStopBtn.innerHTML = '<i class="fa-solid fa-play"></i> Start';
      lapsContainer.innerHTML = '';
      lapCounter = 1;
      laps = [];
      lapBtn.disabled = true;
    }

    function updateTime() {
      updatedTime = new Date().getTime();
      difference = updatedTime - startTime;
      let hours = Math.floor((difference / (1000 * 60 * 60)) % 24);
      let minutes = Math.floor((difference / (1000 * 60)) % 60);
      let seconds = Math.floor((difference / 1000) % 60);
      hours = hours < 10 ? '0' + hours : hours;
      minutes = minutes < 10 ? '0' + minutes : minutes;
      seconds = seconds < 10 ? '0' + seconds : seconds;
      display.innerHTML = `${hours}:${minutes}:${seconds}`;
    }

    function recordLap() {
      if (running) {
        const lapTime = display.innerText;
        const lap = document.createElement('div');
        lap.classList.add('lap');
        lap.innerHTML = `<span>Lap ${lapCounter++}</span><span>${lapTime}</span>`;
        lapsContainer.prepend(lap);
        laps.unshift(lapTime);
      }
    }

    function downloadLaps() {
      if (laps.length === 0) return alert("No laps to download yet!");
      const content = laps.map((t, i) => `Lap ${laps.length - i}: ${t}`).join('\n');
      const blob = new Blob([content], { type: 'text/plain' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'laps_record.txt';
      link.click();
    }

    function copyLaps() {
      if (laps.length === 0) return alert("No laps to copy!");
      const text = laps.map((t, i) => `Lap ${laps.length - i}: ${t}`).join('\n');
      navigator.clipboard.writeText(text)
        .then(() => alert("Laps copied to clipboard ✅"))
        .catch(() => alert("Failed to copy laps ❌"));
    }

    startStopBtn.addEventListener('click', startStop);
    resetBtn.addEventListener('click', reset);
    lapBtn.addEventListener('click', recordLap);
    downloadBtn.addEventListener('click', downloadLaps);
    copyBtn.addEventListener('click', copyLaps);
  </script>
</body>
</html>