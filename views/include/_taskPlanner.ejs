<style>
/* ============
   CONTAINER
   ============ */
.container {
    width: 90%;
    max-width: 900px;
    margin: 120px auto 60px;
    background: rgba(255, 255, 255, 0.07);
    padding: 1.8rem;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(15px);
    box-shadow: 0 0 35px rgba(6,182,212,0.25);
    animation: fadeIn 0.7s ease-out;
}

h2 {
    color: #38bdf8;
    text-align: center;
    margin-bottom: 28px;
    font-size: 1.6rem;
    font-weight: 700;
}

/* ============
   FORM
   ============ */
form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 25px;
}

input, textarea, select {
    padding: 12px;
    border-radius: 10px;
    border: none;
    background: #1e293b;
    color: #f8fafc;
    font-size: 1rem;
}

button {
    padding: 12px;
    border: none;
    border-radius: 10px;
    background: #38bdf8;
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s ease;
}
button:hover {
    background: #0ea5e9;
    transform: translateY(-1px);
}

/* ============
   SORTING
   ============ */
.sort-buttons {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
    justify-content: center;
}

.sort-buttons button {
    background: #64748b;
    font-size: 0.92rem;
    padding: 10px 18px;
}
.sort-buttons button:hover {
    background: #475569;
}

/* ============
   TABLE
   ============ */
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
}

th, td {
    padding: 14px;
    text-align: left;
    border-bottom: 1px solid #334155;
}

th {
    color: #38bdf8;
    font-size: 0.95rem;
    font-weight: 700;
}

td {
    color: #cbd5e1;
    font-size: 0.95rem;
}

.delete-btn {
    color: #ef4444;
    font-weight: 600;
}
.delete-btn:hover {
    color: #f87171;
}

.edit-btn {
    color: #3b82f6;
    font-weight: 600;
}
.edit-btn:hover {
    color: #60a5fa;
}

/* ============
   TOTALS
   ============ */
.totals {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
    margin: 40px 0;
}

.total-card {
    flex: 1 1 160px;
    min-width: 160px;
    border-radius: 18px;
    padding: 22px;
    text-align: center;
    box-shadow: 0 5px 14px rgba(0,0,0,0.35);
    color: #fff;
}

.total-card .icon {
    font-size: 2.3rem;
    margin-bottom: 10px;
}

.total-card h3 {
    margin: 0;
    font-size: 1.1rem;
    opacity: 0.9;
}

.total-card p {
    font-size: 1.8rem;
    font-weight: 700;
}

.pending {
    background: #f59e0b;
}
.completed {
    background: #10b981;
}

/* ============
   MOBILE TABLE
   ============ */
@media(max-width: 768px) {

    table, thead, tbody, th, td, tr {
        display: block;
    }
  
    tr {
        margin-bottom: 16px;
        border-bottom: 2px solid #334155;
        padding-bottom: 12px;
        background: rgba(255,255,255,0.03);
        border-radius: 10px;
    }
  
    td {
        position: relative;
        padding-left: 50%;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        min-height: 35px;
    }

    td:before {
        position: absolute;
        left: 12px;
        width: 45%;
        white-space: nowrap;
        font-weight: 700;
        color: #38bdf8;
        font-size: 0.9rem;
    }

    td:nth-of-type(1):before { content: "Title"; }
    td:nth-of-type(2):before { content: "Description"; }
    td:nth-of-type(3):before { content: "Due Date"; }
    td:nth-of-type(4):before { content: "Status"; }
    td:nth-of-type(5):before { content: "Actions"; }

    th { display: none; }
}

/* ============
   ANIMATIONS
   ============ */
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

</style>
<h1>Task Planner</h1>
<div class="container">
<h2>Welcome, <%= user.fullname %></h2>

<!-- Add Task Form -->
<form action="/task-planner/add" method="POST">
  <input type="text" name="title" placeholder="Task Title" required>
  <textarea name="description" rows="2" placeholder="Description (optional)"></textarea>
  <input type="date" name="dueDate">
  <button type="submit">Add Task</button>
</form>

<!-- Sort Buttons -->
<div class="sort-buttons">
  <button onclick="sortTable('dueDate')">Sort by Due Date</button>
  <button onclick="sortTable('status')">Sort by Status</button>
</div>

<!-- Tasks Table -->
<% if(tasks.length > 0){ %>
<table id="tasksTable">
<thead>
<tr>
<th>Title</th>
<th>Description</th>
<th>Due Date</th>
<th>Status</th>
<th>Action</th>
</tr>
</thead>
<tbody>
<% tasks.forEach(task => { %>
<tr data-due="<%= task.dueDate ? task.dueDate.toISOString() : '' %>" data-status="<%= task.status %>">
<td><%= task.title %></td>
<td><%= task.description || '-' %></td>
<td><%= task.dueDate ? task.dueDate.toDateString() : '-' %></td>
<td><%= task.status %></td>
<td>
  <a href="#" class="edit-btn"><i class="fas fa-edit"></i></a>
  <a href="/task-planner/delete/<%= task._id %>" class="delete-btn" onclick="return confirm('Delete this task?')">Delete</a>
</td>
</tr>
<% }) %>
</tbody>
</table>
<% } else { %>
<p style="text-align:center; color:#94a3b8;">No tasks yet. Add one above!</p>
<% } %>
</div>

<!-- Totals -->
<div class="totals">
  <div class="total-card pending">
    <div class="icon"><i class="fas fa-hourglass-half"></i></div>
    <h3>Pending</h3>
    <p><%= totals.pending %></p>
  </div>
  <div class="total-card completed">
    <div class="icon"><i class="fas fa-check-circle"></i></div>
    <h3>Completed</h3>
    <p><%= totals.completed %></p>
  </div>
</div>

<script>
// --- Edit/Save Tasks ---
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('tr').forEach(row => {
    const editBtn = row.querySelector('.edit-btn');
    if(!editBtn) return;

    editBtn.addEventListener('click', (e)=>{
      e.preventDefault();
      const cells = row.querySelectorAll('td');
      const id = row.querySelector('.delete-btn').href.split('/').pop();
      const original = {
        title: cells[0].textContent,
        description: cells[1].textContent === '-' ? '' : cells[1].textContent,
        dueDate: cells[2].textContent,
        status: cells[3].textContent
      };

      cells[0].innerHTML = `<input type="text" value="${original.title}" style="width:100%"/>`;
      cells[1].innerHTML = `<input type="text" value="${original.description}" style="width:100%"/>`;
      cells[2].innerHTML = `<input type="date" value="${new Date(original.dueDate).toISOString().substr(0,10)}"/>`;
      cells[3].innerHTML = `<select>
        <option ${original.status==='Pending'?'selected':''}>Pending</option>
        <option ${original.status==='Completed'?'selected':''}>Completed</option>
      </select>`;
      cells[4].innerHTML = `<button class="save-btn">Save</button> <button class="cancel-btn">Cancel</button>`;

      const saveBtn = cells[4].querySelector('.save-btn');
      const cancelBtn = cells[4].querySelector('.cancel-btn');

      cancelBtn.addEventListener('click', ()=>{
        cells[0].textContent = original.title;
        cells[1].textContent = original.description || '-';
        cells[2].textContent = original.dueDate;
        cells[3].textContent = original.status;
        cells[4].innerHTML = `<a href="#" class="edit-btn"><i class="fas fa-edit"></i></a>
        <a href="/task-planner/delete/${id}" class="delete-btn" onclick="return confirm('Delete this task?')">Delete</a>`;
      });

      saveBtn.addEventListener('click', async ()=>{
        const updated = {
          title: cells[0].querySelector('input').value.trim() || 'Untitled',
          description: cells[1].querySelector('input').value.trim(),
          dueDate: cells[2].querySelector('input').value,
          status: cells[3].querySelector('select').value
        };
        try{
          const res = await fetch(`/task-planner/edit/${id}`,{
            method:'PUT',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify(updated)
          });
          if(!res.ok) throw new Error('Failed to save');

          cells[0].textContent = updated.title;
          cells[1].textContent = updated.description || '-';
          cells[2].textContent = new Date(updated.dueDate).toDateString();
          cells[3].textContent = updated.status;
          cells[4].innerHTML = `<a href="#" class="edit-btn"><i class="fas fa-edit"></i></a>
            <a href="/task-planner/delete/${id}" class="delete-btn" onclick="return confirm('Delete this task?')">Delete</a>`;
        }catch(err){ alert('Error saving task'); console.error(err);}
      });
    });
  });
});

// --- Sorting ---
function sortTable(type){
  const table = document.getElementById('tasksTable');
  const tbody = table.tBodies[0];
  const rows = Array.from(tbody.querySelectorAll('tr'));

  rows.sort((a,b)=>{
    if(type==='dueDate'){
      return new Date(a.dataset.due) - new Date(b.dataset.due);
    } else if(type==='status'){
      return a.dataset.status.localeCompare(b.dataset.status);
    }
  });

  rows.forEach(row => tbody.appendChild(row));
}
</script>

</body>
</html>
